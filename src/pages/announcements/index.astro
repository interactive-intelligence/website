---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL;

const announcements = (await getCollection('announcements')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmt = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric'
});

const hasBody = (entry: (typeof announcements)[number]) =>
	entry.body && entry.body.trim().length > 0;
---

<Layout title="Announcements - i2">
	<h1>Announcements</h1>
	<p class="lede">
		What's happening at i2. For more updates, join the
		<a href="https://discord.gg/QeGDNYVh" target="_blank" rel="noopener" class="text-link"
			>Discord</a
		>.
	</p>

	<ul class="announcement-cards">
		{
			announcements.map((entry) => {
				const linked = hasBody(entry);
				const detailHref = `${base}announcements/${entry.id}`;
				return (
					<li class={`announcement-card${linked ? ' is-linked' : ''}`}>
						<time datetime={entry.data.date.toISOString()}>
							{fmt.format(entry.data.date)}
						</time>
						<div class="announcement-body">
							<h2>
								{linked ? (
									<a href={detailHref}>
										{entry.data.title}
										<Icon name="mingcute:arrow-right-line" />
									</a>
								) : (
									entry.data.title
								)}
							</h2>
							{entry.data.summary && <p>{entry.data.summary}</p>}
						</div>
					</li>
				);
			})
		}
	</ul>
</Layout>

<style>
	.announcement-cards {
		list-style: none;
		padding: 0;
		margin: 2rem 0 0;
		border-top: 1px solid var(--rule);
	}

	.announcement-card {
		position: relative;
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: 2rem;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.announcement-card time {
		font-size: 0.875rem;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.announcement-card h2 {
		margin: 0;
		font-size: 1.25rem;
	}

	.announcement-card h2 a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		transition: color var(--duration-fast) var(--ease);
	}

	.announcement-card h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.announcement-card h2 a [data-icon] {
		font-size: 0.875em;
		color: var(--text-accent);
		transition: transform var(--duration) var(--ease);
	}

	.announcement-card.is-linked:hover h2 a {
		color: var(--text-accent);
	}

	.announcement-card.is-linked:hover h2 a [data-icon] {
		transform: translateX(4px);
	}

	.announcement-card p {
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
	}

	@media (max-width: 48rem) {
		.announcement-card {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
