---
import { getFeed } from '../../lib/feed'
import Layout from '../../layouts/Layout.astro'
import AnnouncementList from '../../components/AnnouncementList.astro'

const items = await getFeed()
---

<Layout
	title="Announcements - i2"
	description="The latest news, events, and updates from i2."
>
	<h1>Announcements</h1>
	<p class="lede">
		What's happening at i2. For more updates, join the{' '}
		<a href="https://discord.gg/Ph8njzHedC" target="_blank" rel="noopener" class="text-link"
			>Discord</a
		>.
	</p>

	<div class="feed">
		<AnnouncementList items={items} />
	</div>
</Layout>

<style>
	.feed {
		margin-top: 2rem;
	}
</style>
