---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL;

const announcements = (await getCollection('announcements')).sort(
	(a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmt = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric'
});

const hasBody = (entry: (typeof announcements)[number]) =>
	entry.body && entry.body.trim().length > 0;
---

<Layout title="Announcements - i2">
	<h1>Announcements</h1>
	<p class="lede">
		What's happening at i2. For more updates, join the
		<a href="https://discord.gg/QeGDNYVh" target="_blank" rel="noopener" class="text-link"
			>Discord</a
		>.
	</p>

	<ul class="feed">
		{
			announcements.map((entry) => (
				<li class="entry">
					<time datetime={entry.data.date.toISOString()}>
						{fmt.format(entry.data.date)}
					</time>
					<h2>
						{hasBody(entry) ? (
							<a href={`${base}announcements/${entry.id}`}>{entry.data.title}</a>
						) : (
							entry.data.title
						)}
					</h2>
					{entry.data.summary && <p class="summary">{entry.data.summary}</p>}
					<div class="actions">
						{hasBody(entry) && (
							<a href={`${base}announcements/${entry.id}`}>Read more <Icon name="mingcute:arrow-right-line" /></a>
						)}
						{entry.data.link_url && (
							<a href={entry.data.link_url} target="_blank" rel="noopener">
								{entry.data.link_label ?? 'Learn more'} <Icon name="mingcute:arrow-right-line" />
							</a>
						)}
					</div>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.feed {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.entry {
		padding: 1.5rem 1.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.entry time {
		display: block;
		font-size: 0.875rem;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
		margin-bottom: 0.5rem;
	}

	.entry h2 {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
	}

	.entry h2 a:hover {
		text-decoration: underline;
	}

	.summary {
		margin: 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-top: 0.5rem;
		font-weight: 500;
		color: var(--text-accent);
	}

	.actions:empty {
		display: none;
	}

	.actions a:hover {
		text-decoration: underline;
	}
</style>
