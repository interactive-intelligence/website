---
import { getEntries, render } from 'astro:content'
import { getPublished, hasBody, initiativeHref } from '../../lib/content'
import { TIME_ZONE } from '../../lib/dates'
import ArticleLayout from '../../layouts/ArticleLayout.astro'
import LinkButton from '../../components/LinkButton.astro'

export async function getStaticPaths() {
	const announcements = await getPublished('announcements')
	return announcements
		.filter(hasBody)
		.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const initiatives = entry.data.initiatives ? await getEntries(entry.data.initiatives) : []

const fmt = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	timeZone: TIME_ZONE
})
---

<ArticleLayout
	title={entry.data.title}
	description={entry.data.summary}
	summary={entry.data.summary}
	published={entry.data.date}
>
	<Fragment slot="details">
		<div>
			<dt class="label">Posted</dt>
			<dd>
				<time datetime={entry.data.date.toISOString()}>{fmt.format(entry.data.date)}</time>
			</dd>
		</div>
		{
			initiatives.length > 0 && (
				<div>
					<dt class="label">{initiatives.length === 1 ? 'Initiative' : 'Initiatives'}</dt>
					<dd>
						{initiatives.map((i) => (
							<a href={initiativeHref(i)} class="text-link">
								{i.data.name}
							</a>
						))}
					</dd>
				</div>
			)
		}
	</Fragment>

	{
		entry.data.link_url && (
			<div slot="header" class="actions">
				<LinkButton href={entry.data.link_url}>{entry.data.link_label ?? 'Learn more'}</LinkButton>
			</div>
		)
	}

	<section class="prose">
		<Content />
	</section>
</ArticleLayout>

<style>
	dd a {
		display: block;
		color: var(--text);
	}

	.actions {
		margin-top: 2rem;
	}
</style>
