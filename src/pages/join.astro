---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const discordUrl = 'https://discord.gg/QeGDNYVh';

const socials = [
	{
		href: 'https://www.instagram.com/uw_i2/',
		label: 'Instagram',
		icon: 'mingcute:instagram-line'
	},
	{
		href: 'https://www.youtube.com/channel/UCnOSBig3HbEHFUi2HBA7EtA',
		label: 'YouTube',
		icon: 'mingcute:youtube-line'
	},
	{
		href: 'https://twitter.com/InteractiveInt9',
		label: 'X (Twitter)',
		icon: 'mingcute:social-x-line'
	},
	{
		href: 'https://github.com/interactive-intelligence',
		label: 'GitHub',
		icon: 'mingcute:github-line'
	}
];
---

<Layout title="Join Us - i2">
	<h1>Join us</h1>

	<section class="hero-cta">
		<div class="cta-text">
			<h2 id="discord">
				Discord<a class="heading-anchor" href="#discord" aria-label="Link to section">#</a>
			</h2>
			<p>
				i2 runs on Discord. It's where we announce events, share resources, organize
				initiatives, and chat day-to-day. Open to all UW students interested in NeuroAI,
				regardless of background or major.
			</p>
		</div>
		<a href={discordUrl} target="_blank" rel="noopener" class="btn btn-primary cta-btn">
			<Icon name="mingcute:discord-line" />
			Join Discord
		</a>
	</section>
	<div class="socials">
		{
			socials.map(({ href, label, icon }) => (
				<a
					href={href}
					target="_blank"
					rel="noopener noreferrer"
					class="btn btn-surface social-card"
				>
					<Icon name={icon} />
					{label}
				</a>
			))
		}
	</div>

	{/* When an interest form or signup is active, link it here as a secondary CTA. */}
</Layout>

<style>
	.hero-cta {
		margin-top: 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 3rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);

		h2 {
			font-size: 1.5rem;
		}
		p {
			margin: 0;
		}
		.btn {
			flex-shrink: 0;
		}
	}

	.socials {
		margin-top: 1rem;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.social-card {
		justify-content: center;
		padding: 1rem;

		[data-icon] {
			font-size: 1.5rem;
		}
	}

	.cta-btn [data-icon] {
		font-size: 1.5rem;
	}
</style>
