---
import Layout from '../layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import LinkButton from '../components/LinkButton.astro'
import ListCard from '../components/ListCard.astro'
import { discordUrl } from '../lib/links'
import { closesAttr, getOpenLinks } from '../lib/content'
import { TIME_ZONE, hasTime } from '../lib/dates'

const links = await getOpenLinks()

const dateFmt = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	timeZone: TIME_ZONE
})

const dateTimeFmt = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZone: TIME_ZONE
})

// "Closes Oct 5" for a date-only deadline, "Closes Oct 5, 11:59 PM" for one with a time.
const closesLabel = (closes: Date) =>
	`Closes ${(hasTime(closes) ? dateTimeFmt : dateFmt).format(closes)}`

const linkMeta = (l: (typeof links)[number]) =>
	[l.data.description, l.data.closes && closesLabel(l.data.closes)].filter(Boolean).join(' · ')

const socials = [
	{
		href: 'https://www.instagram.com/uw_i2/',
		label: 'Instagram',
		icon: 'mingcute:instagram-line'
	},
	{
		href: 'https://www.youtube.com/channel/UCnOSBig3HbEHFUi2HBA7EtA',
		label: 'YouTube',
		icon: 'mingcute:youtube-line'
	},
	{
		href: 'https://twitter.com/InteractiveInt9',
		label: 'X (Twitter)',
		icon: 'mingcute:social-x-line'
	},
	{
		href: 'https://github.com/interactive-intelligence',
		label: 'GitHub',
		icon: 'mingcute:github-line'
	}
]
---

<Layout
	title="Join Us - i2"
	description="Join interactive intelligence (i2) at UW. Hop into our Discord, follow us on social media, and get involved in NeuroAI education and research."
>
	<h1>Join us</h1>

	<section class="hero-cta">
		<div class="cta-text">
			<h2 id="discord">
				Discord<a class="heading-anchor" href="#discord" aria-label="Link to section">#</a>
			</h2>
			<p>
				i2 runs on Discord. It's where we announce events, share resources, organize
				initiatives, and chat. Open to all UW students interested in NeuroAI,
				regardless of background or major.
			</p>
		</div>
		<LinkButton href={discordUrl} class="cta-btn" arrow={false}>
			<Icon aria-hidden="true" name="mingcute:discord-line" />
			Join Discord
		</LinkButton>
	</section>
	<div class="socials">
		{
			socials.map(({ href, label, icon }) => (
				<LinkButton href={href} variant="surface" class="social-card" arrow={false}>
					<Icon aria-hidden="true" name={icon} />
					{label}
				</LinkButton>
			))
		}
	</div>

	{
		links.length > 0 && (
			<section class="links">
				<h2 id="get-involved">
					Get involved
					<a class="heading-anchor" href="#get-involved" aria-label="Link to section">
						#
					</a>
				</h2>
				<ul class="link-list">
					{links.map((l) => (
						<li data-closes={closesAttr(l)}>
							<ListCard
								href={l.data.url}
								title={l.data.title}
								meta={linkMeta(l)}
							/>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Layout>

<style>
	.hero-cta {
		margin-top: 1rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 3rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);

		h2 {
			font-size: 1.5rem;
		}
		p {
			margin: 0;
		}
		.btn {
			flex-shrink: 0;
		}
	}

	.socials {
		margin-top: 1rem;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.social-card {
		justify-content: center;
		padding: 1rem;

		[data-icon] {
			font-size: 1.5rem;
		}
	}

	.cta-btn [data-icon] {
		font-size: 1.5rem;
	}

	.links {
		margin-top: 3rem;
	}

	/* Every link closed since the last build. */
	.links:not(:has(li:not([hidden]))) {
		display: none;
	}

	.link-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.link-list li {
		margin: 0;
	}
</style>
