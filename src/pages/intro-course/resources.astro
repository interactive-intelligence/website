---
import { getEntry, render } from 'astro:content'
import CourseLayout from '../../layouts/CourseLayout.astro'
import ListCard from '../../components/ListCard.astro'

const resources = await getEntry('coursePages', 'resources')
if (!resources) {
	throw new Error('Missing src/content/course/resources.md')
}

const { Content } = await render(resources)
const links = resources.data.links ?? []
---

<CourseLayout
	title="Resources"
	description="Forms, slides, and lecture recordings for i2's Intro Course."
>
	<div class="prose">
		<Content />
	</div>

	<ul class="list-reset cards">
		{
			links.map((link) => (
				<li>
					<ListCard href={link.url} title={link.title} />
				</li>
			))
		}
	</ul>
</CourseLayout>

<style>
	/* Two columns at most, like the page cards on the course home; one column when there isn't room for two. */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(max(14rem, calc(50% - 0.25rem)), 1fr));
		gap: 0.5rem;
	}

	.cards li > :global(a) {
		height: 100%;
	}
</style>
