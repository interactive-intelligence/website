---
import { Image, Picture } from 'astro:assets'
import { getCollection } from 'astro:content'
import { getAnnouncements, hasBody } from '../lib/content'
import InitiativesAccordion from '../components/InitiativesAccordion.astro'
import Layout from '../layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import heroLarge from '../assets/presentation.jpg'
import heroWide from '../assets/introcourse.jpg'
import heroSmallA from '../assets/clubfair.jpg'
import heroSmallB from '../assets/selfie.jpg'
import allenLogo from '../assets/allen-school-logo.svg'
import cntLogo from '../assets/cnt-logo.png'

const base = import.meta.env.BASE_URL

const description =
	"interactive intelligence (i2) is the University of Washington's student-led NeuroAI education and research organization, exploring the intersection of AI, neuroscience, and philosophy."

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'interactive intelligence',
	alternateName: 'i2',
	url: new URL(base, Astro.site).toString(),
	logo: new URL(`${base}favicon.svg`, Astro.site).toString(),
	description,
	parentOrganization: { '@type': 'CollegeOrUniversity', name: 'University of Washington' },
	sameAs: [
		'https://www.instagram.com/uw_i2/',
		'https://www.youtube.com/channel/UCnOSBig3HbEHFUi2HBA7EtA',
		'https://twitter.com/InteractiveInt9',
		'https://github.com/interactive-intelligence'
	]
}

const initiatives = (await getCollection('initiatives')).sort((a, b) => a.data.order - b.data.order)

const recentAnnouncements = (await getAnnouncements())
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3)

const announcementDateFmt = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric'
})

const heroFormats = ['avif', 'webp'] as const

const stats = [
	{ value: '180', plus: true, label: 'Intro Course graduates since 2023' },
	{ value: '140', plus: true, label: 'Active members across 5 initiatives' },
	{ value: '7', label: 'Research Room teams' },
	{ value: '11', label: 'Talks hosted with researchers' }
]
---

<Layout title="i2 - interactive intelligence" description={description}>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(organizationSchema)} />
	<h1 class="hero">
		<span>interactive intelligence</span>
		<span>(i2)</span>
	</h1>

	<div class="hero-images">
		<div class="cell cell-large"><Picture src={heroLarge} formats={heroFormats} alt="" loading="eager" fetchpriority="high" /></div>
		<div class="cell cell-wide"><Picture src={heroWide} formats={heroFormats} alt="" loading="eager" /></div>
		<div class="cell"><Picture src={heroSmallA} formats={heroFormats} alt="" /></div>
		<div class="cell"><Picture src={heroSmallB} formats={heroFormats} alt="" /></div>
	</div>

	<p class="lede">
		i2 is UW's student-led NeuroAI education and research organization. We aim to create a
		community of project-driven, outcome-oriented students interested in the intersections of
		artificial intelligence, neuroscience, and philosophy. We are interested in how machines can
		learn like humans.
	</p>

	<section class="initiatives">
		<h2 id="initiatives">
			Our initiatives<a
				class="heading-anchor"
				href="#initiatives"
				aria-label="Link to section">#</a
			>
		</h2>
		<InitiativesAccordion items={initiatives} />
	</section>

	<section class="numbers">
		<h2 id="by-the-numbers">
			By the numbers<a
				class="heading-anchor"
				href="#by-the-numbers"
				aria-label="Link to section">#</a
			>
		</h2>
		<div class="stats">
			{
				stats.map((s) => (
					<div class="stat">
						<div class="value">
							{s.value}
							{s.plus && <span class="plus">+</span>}
						</div>
						<div class="label">{s.label}</div>
					</div>
				))
			}
		</div>
	</section>

	{
		recentAnnouncements.length > 0 && (
			<section class="announcements">
				<header class="announcements-header">
					<h2 id="announcements">
						Announcements
						<a
							class="heading-anchor"
							href="#announcements"
							aria-label="Link to section"
						>
							#
						</a>
					</h2>
					<a href={`${base}announcements`} class="link-arrow">
						See all <Icon name="mingcute:arrow-right-line" />
					</a>
				</header>
				<ul class="announcement-cards">
					{recentAnnouncements.map((entry) => {
						const linked = hasBody(entry)
						const detailHref = `${base}announcements/${entry.id}`
						return (
							<li class={`announcement-card${linked ? ' is-linked' : ''}`}>
								<time datetime={entry.data.date.toISOString()}>
									{announcementDateFmt.format(entry.data.date)}
								</time>
								<div class="announcement-body">
									<h3>
										{linked ? (
											<a href={detailHref}>
												{entry.data.title}
												<Icon name="mingcute:arrow-right-line" />
											</a>
										) : (
											entry.data.title
										)}
									</h3>
									{entry.data.summary && <p>{entry.data.summary}</p>}
								</div>
							</li>
						)
					})}
				</ul>
			</section>
		)
	}

	<section class="affiliations">
		<h2 id="affiliations">
			Affiliations<a class="heading-anchor" href="#affiliations" aria-label="Link to section"
				>#</a
			>
		</h2>
		<div class="affil-cards">
			<a
				href="https://www.cs.washington.edu"
				target="_blank"
				rel="noopener"
				class="affil-card affil-allen"
			>
				<Image
					src={allenLogo}
					alt="Paul G. Allen School of Computer Science & Engineering"
				/>
			</a>
			<a
				href="https://centerforneurotech.uw.edu"
				target="_blank"
				rel="noopener"
				class="affil-card affil-cnt"
			>
				<Image src={cntLogo} alt="UW Center for Neurotechnology" />
			</a>
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 2rem;
		font-size: clamp(2.5rem, 100cqi / 10.5, 4rem);
		line-height: 1;
		letter-spacing: -0.04em;
	}

	@container (width <= 26.25rem) {
		.hero {
			font-size: 3.25rem;
		}
	}

	.hero-images {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		grid-template-rows: repeat(2, clamp(5rem, 18vw, 9rem));
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.cell {
		overflow: hidden;
		border-radius: var(--radius);
	}

	.cell-large {
		grid-row: span 2;
	}

	.cell-wide {
		grid-column: span 2;
	}

	.cell :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--duration-slow) var(--ease);
	}

	.cell:hover :global(img) {
		transform: scale(1.06);
	}

	.lede {
		margin-top: 2rem;
		font-size: 1.125rem;
	}

	section {
		margin-top: 5rem;
	}

	.initiatives {
		display: grid;
		grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
		gap: 4rem;
		align-items: start;
	}

	.initiatives h2 {
		font-size: clamp(1.75rem, 1.25rem + 2vw, 2.25rem);
		position: sticky;
		margin: 0;
		top: 2rem;
	}

	h2 {
		margin-bottom: 1rem;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1rem;
	}

	.announcements-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.announcements-header h2 {
		margin: 0;
	}

	.announcement-cards {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--rule);
	}

	.announcement-card {
		position: relative;
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		gap: 2rem;
		margin-top: 0;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.announcement-card time {
		font-size: 0.875rem;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	.announcement-card h3 {
		margin: 0;
	}

	.announcement-card h3 a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		transition: color var(--duration-fast) var(--ease);
	}

	.announcement-card h3 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.announcement-card h3 a [data-icon] {
		font-size: 0.875em;
		color: var(--text-accent);
		transition: transform var(--duration) var(--ease);
	}

	.announcement-card.is-linked:hover h3 a {
		color: var(--text-accent);
	}

	.announcement-card.is-linked:hover h3 a [data-icon] {
		transform: translateX(4px);
	}

	.announcement-card p {
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
	}

	.affil-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 1rem;
	}

	.affil-card {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem 2rem;
		border-radius: var(--radius);
		transition:
			opacity var(--duration-fast) var(--ease),
			transform var(--duration-fast) var(--ease);
	}

	.affil-card:hover {
		opacity: 0.85;
		transform: scale(1.02);
	}

	.affil-card:active {
		transform: scale(0.98);
	}

	.affil-allen {
		background: var(--accent-dark);
	}

	.affil-cnt {
		background: var(--black);
	}

	.affil-card :global(img) {
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.stat .value {
		display: flex;
		align-items: center;
		font-size: clamp(2.5rem, 1.5rem + 4vw, 3.5rem);
		font-weight: 600;
		line-height: 1;
	}

	.stat .plus {
		font-size: 0.7em;
		margin-left: 0.125rem;
		font-weight: 400;
		color: var(--text-accent);
	}

	.stat .label {
		font-size: 0.75rem;
	}

	@media (max-width: 56rem) {
		.hero span:last-child {
			display: none;
		}

		section {
			margin-top: 3.5rem;
		}

		.initiatives {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.initiatives h2 {
			position: static;
		}

		.announcement-card {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
