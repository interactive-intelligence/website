---
import { Image, Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import InitiativesAccordion from '../components/InitiativesAccordion.astro';
import Layout from '../layouts/Layout.astro';
import hero1 from '../assets/hero-1.jpg';
import hero2 from '../assets/hero-2.jpg';
import hero3 from '../assets/hero-3.jpg';
import allenLogo from '../assets/allen-school-logo.svg';
import cntLogo from '../assets/cnt-logo.png';

const base = import.meta.env.BASE_URL;

const initiatives = (await getCollection('initiatives')).sort(
	(a, b) => a.data.order - b.data.order
);

const recentAnnouncements = (await getCollection('announcements'))
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);

const announcementDateFmt = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric'
});

const announcementHasBody = (entry: (typeof recentAnnouncements)[number]) =>
	entry.body && entry.body.trim().length > 0;

const stats = [
	{ value: '180', plus: true, label: 'Intro Course graduates since 2023' },
	{ value: '140', plus: true, label: 'Active members across 5 initiatives' },
	{ value: '7', label: 'Research Room teams' },
	{ value: '11', label: 'Talks hosted with researchers' }
];

const heroImages = [hero1, hero2, hero3];
---

<Layout title="i2 - interactive intelligence">
	<h1 class="hero">
		<span>interactive intelligence</span>
		<span>(i2)</span>
	</h1>

	<div class="hero-images">
		{heroImages.map((img) => <Picture src={img} formats={['avif', 'webp']} alt="" />)}
	</div>

	<p class="lede">
		i2 is UW's student-led NeuroAI education and research organization. We aim to create a
		community of project-driven, outcome-oriented students interested in the intersections of
		artificial intelligence, neuroscience, and philosophy. We are interested in how machines can
		learn like humans.
	</p>

	<section class="initiatives">
		<h2 id="initiatives">
			Our initiatives<a
				class="heading-anchor"
				href="#initiatives"
				aria-label="Link to section">#</a
			>
		</h2>
		<InitiativesAccordion items={initiatives} />
	</section>

	<section class="numbers">
		<h2 id="by-the-numbers">
			By the numbers<a
				class="heading-anchor"
				href="#by-the-numbers"
				aria-label="Link to section">#</a
			>
		</h2>
		<div class="stats">
			{
				stats.map((s) => (
					<div class="stat">
						<div class="value">
							{s.value}
							{s.plus && <span class="plus">+</span>}
						</div>
						<div class="label">{s.label}</div>
					</div>
				))
			}
		</div>
	</section>

	{
		recentAnnouncements.length > 0 && (
			<section class="announcements">
				<header class="announcements-header">
					<h2 id="announcements">
						Announcements
						<a
							class="heading-anchor"
							href="#announcements"
							aria-label="Link to section"
						>
							#
						</a>
					</h2>
					<a href={`${base}announcements`} class="see-all">
						See all &rarr;
					</a>
				</header>
				<ul class="announcement-cards">
					{recentAnnouncements.map((entry) => {
						const hasBody = announcementHasBody(entry);
						const detailHref = `${base}announcements/${entry.id}`;
						return (
							<li class="announcement-card">
								<time datetime={entry.data.date.toISOString()}>
									{announcementDateFmt.format(entry.data.date)}
								</time>
								<h3>
									{hasBody ? (
										<a href={detailHref}>{entry.data.title}</a>
									) : (
										entry.data.title
									)}
								</h3>
								{entry.data.summary && <p>{entry.data.summary}</p>}
								<div class="card-actions">
									{hasBody && <a href={detailHref}>Read more &rarr;</a>}
									{entry.data.link_url && (
										<a
											href={entry.data.link_url}
											target="_blank"
											rel="noopener"
										>
											{entry.data.link_label ?? 'Learn more'} &rarr;
										</a>
									)}
								</div>
							</li>
						);
					})}
				</ul>
			</section>
		)
	}

	<section class="affiliations">
		<h2 id="affiliations">
			Affiliations<a class="heading-anchor" href="#affiliations" aria-label="Link to section"
				>#</a
			>
		</h2>
		<div class="affil-cards">
			<a
				href="https://www.cs.washington.edu"
				target="_blank"
				rel="noopener"
				class="affil-card affil-allen"
			>
				<Image
					src={allenLogo}
					alt="Paul G. Allen School of Computer Science & Engineering"
				/>
			</a>
			<a
				href="https://centerforneurotech.uw.edu"
				target="_blank"
				rel="noopener"
				class="affil-card affil-cnt"
			>
				<Image src={cntLogo} alt="UW Center for Neurotechnology" />
			</a>
		</div>
	</section>
</Layout>

<style>
	.hero {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 2rem;
		font-size: 4rem;
		line-height: 1;
		letter-spacing: -0.04em;
	}

	.hero-images {
		display: flex;
		height: 18rem;
		margin-top: 1rem;
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.hero-images :global(img) {
		flex: 1;
		min-width: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.lede {
		margin-top: 2rem;
		font-size: 1.125rem;
	}

	section {
		margin-top: 5rem;
	}

	.initiatives {
		display: grid;
		grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
		gap: 4rem;
		align-items: start;
		margin-top: 5rem;
	}

	.initiatives h2 {
		font-size: 2.25rem;
		position: sticky;
		margin: 0;
		top: 2rem;
	}

	h2 {
		margin-bottom: 1rem;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.stat {
		background: var(--surface);
		border-radius: var(--radius);
		border: 1px solid var(--border);
	}

	.announcements-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.announcements-header h2 {
		margin: 0;
	}

	.see-all {
		font-weight: 500;
		color: var(--text-accent);
	}

	.see-all:hover {
		text-decoration: underline;
	}

	.announcement-cards {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.announcement-card {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.announcement-card time {
		font-size: 0.875rem;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
	}

	.announcement-card h3 {
		margin: 0;
	}

	.announcement-card h3 a:hover {
		text-decoration: underline;
	}

	.announcement-card p {
		margin: 0;
		font-size: 0.875rem;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.875rem;
		margin-top: auto;
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--text-accent);
	}

	.card-actions:empty {
		display: none;
	}

	.card-actions a:hover {
		text-decoration: underline;
	}

	.affil-cards {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.affil-card {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem 2rem;
		border-radius: var(--radius);
	}

	.affil-card:hover {
		opacity: 0.8;
	}

	.affil-allen {
		background: var(--accent-dark);
	}

	.affil-cnt {
		background: #000;
	}

	.affil-card :global(img) {
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	.stat {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		gap: 0.5rem;
	}

	.stat .value {
		display: flex;
		align-items: center;
		font-size: 3.5rem;
		font-weight: 600;
		line-height: 1;
	}

	.stat .plus {
		font-size: 2.5rem;
		margin-left: 0.125rem;
		font-weight: 400;
		color: var(--text-accent);
	}

	.stat .label {
		font-size: 0.75rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.accordion .indicator::after,
		.accordion .panel {
			transition: none;
		}
	}

	@media (max-width: 48rem) {
		.hero {
			font-size: 2.5rem;
		}

		.initiatives {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.stats {
			grid-template-columns: repeat(2, 1fr);
		}

		.announcement-cards {
			grid-template-columns: 1fr;
		}

		.affil-cards {
			grid-template-columns: 1fr;
		}
	}
</style>
