---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;

const [initiatives, schedules] = await Promise.all([
	getCollection('initiatives'),
	getCollection('schedule')
]);

const initiativesById = new Map(initiatives.map((i) => [i.id, i]));

const today = new Date();

const status = (start: Date, end: Date) => {
	if (today < start) return 'upcoming';
	if (today > end) return 'past';
	return 'current';
};

const years = [...schedules]
	.sort((a, b) => a.data.year.localeCompare(b.data.year))
	.map((entry) => ({
		year: entry.data.year,
		quarters: entry.data.quarters.map((q) => ({
			...q,
			status: status(q.start, q.end),
			items: q.initiatives
				.map((id) => initiativesById.get(id))
				.filter((i): i is NonNullable<typeof i> => Boolean(i))
		}))
	}));

const defaultIndex = Math.max(
	0,
	years.findIndex((y) => y.quarters.some((q) => q.status === 'current'))
);
const initialIndex = defaultIndex === -1 ? years.length - 1 : defaultIndex;
---

<Layout title="Schedule - i2">
	<h1>Schedule</h1>
	<div class="lede-row">
		<p class="lede">
			What's running each quarter. Switch between academic years to see past programming or
			what's coming up.
		</p>
		<div
			class="year-switcher"
			data-year-switcher
			data-count={years.length}
			data-index={initialIndex}
		>
			<button
				type="button"
				class="year-nav"
				data-dir="-1"
				aria-label="Previous academic year"
			>
				&larr;
			</button>
			<span class="year-label" data-year-label>{years[initialIndex].year}</span>
			<button type="button" class="year-nav" data-dir="1" aria-label="Next academic year">
				&rarr;
			</button>
		</div>
	</div>

	<section class="overview">
		<div class="years">
			{
				years.map((y, idx) => (
					<div
						class="quarters"
						data-year-panel
						data-year={y.year}
						hidden={idx !== initialIndex}
					>
						{y.quarters.map((q) => (
							<article class="quarter" data-status={q.status}>
								<header class="quarter-header">
									<h3>{q.name}</h3>
									{q.status === 'current' && <span class="badge">Now</span>}
									{q.status === 'upcoming' && (
										<span class="badge badge-upcoming">Upcoming</span>
									)}
								</header>
								<ul class="initiative-list">
									{q.items.map((item) => (
										<li>
											<a
												href={
													item.data.external_url ??
													`${base}initiatives/${item.id}`
												}
												class="initiative-chip"
											>
												{item.data.name}
											</a>
										</li>
									))}
								</ul>
								{q.note && <p class="quarter-note">{q.note}</p>}
							</article>
						))}
					</div>
				))
			}
		</div>
	</section>

	<section>
		<h2 id="events">
			Events<a class="heading-anchor" href="#events" aria-label="Link to section">#</a>
		</h2>
		<p>All meetings and events are on our public Google Calendar.</p>
		<div class="calendar-embed">
			<iframe
				title="i2 Google Calendar"
				src="https://calendar.google.com/calendar/embed?src=REPLACE_WITH_CALENDAR_ID&ctz=America%2FLos_Angeles&mode=AGENDA&showTitle=0&showNav=1&showDate=1&showPrint=0&showTabs=1&showCalendars=0&showTz=0"
				loading="lazy"
				frameborder="0"
				scrolling="no"></iframe>
		</div>
	</section>
</Layout>

<script>
	const switcher = document.querySelector<HTMLElement>('[data-year-switcher]');
	if (switcher) {
		const count = Number(switcher.dataset.count);
		const label = switcher.querySelector<HTMLElement>('[data-year-label]')!;
		const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-year-panel]'));
		const buttons = switcher.querySelectorAll<HTMLButtonElement>('.year-nav');

		const show = (index: number) => {
			switcher.dataset.index = String(index);
			panels.forEach((p, i) => {
				p.hidden = i !== index;
			});
			label.textContent = panels[index].dataset.year ?? '';
			buttons.forEach((btn) => {
				const dir = Number(btn.dataset.dir);
				const target = index + dir;
				btn.disabled = target < 0 || target >= count;
			});
		};

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const current = Number(switcher.dataset.index);
				const next = current + Number(btn.dataset.dir);
				if (next < 0 || next >= count) return;
				show(next);
			});
		});

		show(Number(switcher.dataset.index));
	}
</script>

<style>
	.lede-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
	}

	.lede-row .lede {
		margin: 0;
		flex: 1;
	}

	.year-switcher {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.year-label {
		min-width: 6.5rem;
		text-align: center;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
		font-weight: 500;
	}

	.year-nav {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: var(--surface);
		border: 1px solid var(--border);
		color: var(--text);
		font-size: 1rem;
		line-height: 1;
		transition:
			background 0.15s,
			opacity 0.15s;
	}

	.year-nav:hover:not(:disabled) {
		background: var(--accent-light);
	}

	.year-nav:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.overview {
		margin-top: 1rem;
	}

	.lede {
		margin-bottom: 2.5rem;
	}

	.calendar-embed {
		margin-top: 1rem;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--border);
		background: var(--surface);
	}

	.calendar-embed iframe {
		display: block;
		width: 100%;
		height: 36rem;
		border: 0;
	}

	.years {
		position: relative;
	}

	.quarters {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.quarters[hidden] {
		display: grid;
		position: absolute;
		inset: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.quarter {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.25rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: opacity 0.2s;
	}

	.quarter[data-status='past'] {
		opacity: 0.5;
	}

	.quarter[data-status='current'] {
		background: var(--accent-light);
		border-color: var(--border-accent-light);
	}

	.quarter-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.quarter-header h3 {
		margin: 0;
		font-size: 1.125rem;
	}

	.badge {
		font-size: 0.75rem;
		font-weight: 600;
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: white;
		letter-spacing: 0.02em;
	}

	.badge-upcoming {
		background: transparent;
		color: var(--text-accent);
		border: 1px solid var(--rule);
	}

	.initiative-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.initiative-list li {
		margin: 0;
	}

	.initiative-chip {
		display: block;
		padding: 0.5rem 0.75rem;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: calc(var(--radius) / 2);
		font-size: 0.9375rem;
		transition:
			border-color 0.15s,
			transform 0.15s;
	}

	.initiative-chip:hover {
		border-color: var(--rule);
		transform: translateX(2px);
	}

	.quarter-note {
		margin: 0;
		font-size: 0.875rem;
		color: var(--text-accent);
	}

	@media (max-width: 48rem) {
		.quarters {
			grid-template-columns: 1fr;
		}
	}
</style>
