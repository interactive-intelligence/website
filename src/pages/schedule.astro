---
import { getCollection } from 'astro:content';
import { getTalks } from '../lib/content';
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import TalkCard from '../components/TalkCard.astro';

const base = import.meta.env.BASE_URL;

const [initiatives, schedules, talksCollection] = await Promise.all([
	getCollection('initiatives'),
	getCollection('schedule'),
	getTalks()
]);

const initiativesById = new Map(initiatives.map((i) => [i.id, i]));
const talksInitiative = initiativesById.get('talks');

const today = new Date();

const upcomingTalks = talksCollection
	.filter((t) => t.data.date.getTime() >= today.getTime())
	.sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
	.slice(0, 2);


const status = (start: Date, end: Date) => {
	if (today < start) return 'upcoming';
	if (today > end) return 'past';
	return 'current';
};

const years = [...schedules]
	.sort((a, b) => a.data.year.localeCompare(b.data.year))
	.map((entry) => {
		const quarters = entry.data.quarters.map((q) => {
			const items = new Map<string, { time?: string }>();
			for (const i of q.initiatives) {
				if (i.id === 'talks') continue;
				if (!initiativesById.has(i.id)) continue;
				items.set(i.id, { time: i.time });
			}
			return { ...q, status: status(q.start, q.end), items };
		});

		const ids = new Set<string>();
		quarters.forEach((q) => q.items.forEach((_, id) => ids.add(id)));
		const rows = [...ids]
			.map((id) => initiativesById.get(id)!)
			.sort((a, b) => a.data.order - b.data.order);

		return { year: entry.data.year, quarters, rows };
	});

const defaultIndex = years.findIndex((y) => y.quarters.some((q) => q.status === 'current'));
const initialIndex = defaultIndex === -1 ? years.length - 1 : defaultIndex;
---

<Layout
	title="Schedule - i2"
	description="Meeting times for every i2 initiative across the school year, plus upcoming events."
>
	<h1>Schedule</h1>
	<div class="lede-row">
		<p class="lede">What programs are running each quarter.</p>
		<div
			class="year-switcher"
			data-year-switcher
			data-count={years.length}
			data-index={initialIndex}
		>
			<button
				type="button"
				class="year-nav"
				data-dir="-1"
				aria-label="Previous academic year"
			>
				<Icon name="mingcute:arrow-left-line" />
			</button>
			<span class="year-label" data-year-label>{years[initialIndex].year}</span>
			<button type="button" class="year-nav" data-dir="1" aria-label="Next academic year">
				<Icon name="mingcute:arrow-right-line" />
			</button>
		</div>
	</div>

	<section class="overview">
		<div class="years">
			{
				years.map((y, idx) => (
					<div
						class="matrix"
						data-year-panel
						data-year={y.year}
						hidden={idx !== initialIndex}
						style={`--rows: ${y.rows.length + 1}`}
					>
						<div class="m-cell m-corner" aria-hidden="true" />
						{y.rows.map((row) => (
							<div class="m-cell m-label">
								<a href={row.data.external_url ?? `${base}initiatives/${row.id}`}>
									{row.data.name}
								</a>
							</div>
						))}

						{y.quarters.map((q) => (
							<>
								<div class="m-cell m-head" data-status={q.status}>
									<span class="m-head-name">{q.name}</span>
									{q.status === 'current' && <span class="badge">Now</span>}
									{q.status === 'upcoming' && (
										<span class="badge badge-upcoming">Upcoming</span>
									)}
								</div>
								{y.rows.map((row) => {
									const entry = q.items.get(row.id);
									return (
										<div
											class="m-cell m-data"
											data-status={q.status}
											data-active={entry ? 'true' : 'false'}
										>
											<a
												class="m-name"
												href={row.data.external_url ?? `${base}initiatives/${row.id}`}
											>
												{row.data.name}
											</a>
											{entry ? (
												<span class="m-time">{entry.time ?? 'TBD'}</span>
											) : (
												<span class="m-empty" aria-label="Not running">
													—
												</span>
											)}
										</div>
									);
								})}
							</>
						))}
					</div>
				))
			}
		</div>
	</section>

	<section>
		<div class="talks-widget-head">
			<h2>Upcoming talks</h2>
			<a class="link-arrow" href={`${base}initiatives/talks`}>
				<span>All talks</span>
				<Icon name="mingcute:arrow-right-line" />
			</a>
		</div>
		{
			upcomingTalks.length > 0 ? (
				<ul class="talks-list">
					{upcomingTalks.map((t) => (
						<li>
							<TalkCard talk={t} />
						</li>
					))}
				</ul>
			) : (
				<p class="talks-empty">
					No talks currently scheduled. More information will be available as new speakers
					are confirmed.
				</p>
			)
		}
	</section>

	<section>
		<h2 id="calendar">
			Calendar<a class="heading-anchor" href="#calendar" aria-label="Link to section">#</a>
		</h2>
		<p>All meetings and events are on our public Google Calendar.</p>
		<div class="calendar-embed">
			<iframe
				title="i2 Google Calendar"
				src="https://calendar.google.com/calendar/embed?src=REPLACE_WITH_CALENDAR_ID&ctz=America%2FLos_Angeles&mode=AGENDA&showTitle=0&showNav=1&showDate=1&showPrint=0&showTabs=1&showCalendars=0&showTz=0"
				loading="lazy"
				frameborder="0"
				scrolling="no"></iframe>
		</div>
	</section>
</Layout>

<script>
	const switcher = document.querySelector<HTMLElement>('[data-year-switcher]');
	if (switcher) {
		const count = Number(switcher.dataset.count);
		const label = switcher.querySelector<HTMLElement>('[data-year-label]')!;
		const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-year-panel]'));
		const buttons = switcher.querySelectorAll<HTMLButtonElement>('.year-nav');

		const show = (index: number) => {
			switcher.dataset.index = String(index);
			panels.forEach((p, i) => {
				p.hidden = i !== index;
			});
			label.textContent = panels[index].dataset.year ?? '';
			buttons.forEach((btn) => {
				const dir = Number(btn.dataset.dir);
				const target = index + dir;
				btn.disabled = target < 0 || target >= count;
			});
		};

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const current = Number(switcher.dataset.index);
				const next = current + Number(btn.dataset.dir);
				if (next < 0 || next >= count) return;
				show(next);
			});
		});

		show(Number(switcher.dataset.index));
	}
</script>

<style>
	.lede-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
	}

	.lede-row .lede {
		margin: 0;
		flex: 1;
	}

	.year-switcher {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.year-label {
		min-width: 6.5rem;
		text-align: center;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
		font-weight: 500;
	}

	.year-nav {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: var(--surface);
		border: 1px solid var(--border);
		color: var(--text);
		font-size: 1rem;
		line-height: 1;
		transition:
			background var(--duration-fast) var(--ease),
			border-color var(--duration-fast) var(--ease),
			opacity var(--duration-fast) var(--ease);
	}

	.year-nav:hover:not(:disabled) {
		background: var(--accent-light);
		border-color: var(--border-accent-light);
	}

	.year-nav:disabled {
		opacity: 0.3;
		cursor: not-allowed;
	}

	.overview {
		margin-top: 1rem;
	}

	.years {
		position: relative;
	}

	/* Cells are emitted column-major (labels, then each quarter); 1px gaps draw the grid lines. */
	.matrix {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) repeat(3, minmax(0, 1fr));
		grid-template-rows: repeat(var(--rows), auto);
		grid-auto-flow: column;
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.matrix[hidden] {
		display: grid;
		position: absolute;
		inset: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.m-cell {
		padding: 1rem;
		background: var(--surface);
		min-width: 0;
	}

	.m-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.m-head[data-status='past'] {
		opacity: 0.6;
	}

	.m-head[data-status='current'] {
		background: var(--accent-light);
	}

	.m-head-name {
		font-weight: 500;
	}

	.badge {
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.125rem 0.5rem;
		border-radius: 999px;
		background: var(--accent-dark);
		color: var(--text-inverse);
	}

	.badge-upcoming {
		background: transparent;
		color: var(--text-accent);
		border: 1px solid var(--rule);
	}

	.m-label {
		display: flex;
		align-items: center;
		font-weight: 500;
	}

	.m-name {
		display: none;
	}

	.m-label a,
	.m-name {
		color: var(--text);
		text-decoration: none;
		font-weight: 500;
		transition: color var(--duration-fast) var(--ease);
	}

	.m-label a:hover,
	.m-name:hover {
		color: var(--text-accent);
	}

	.m-data {
		display: flex;
		align-items: center;
		font-size: 0.875rem;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
	}

	.m-data[data-status='past'] {
		opacity: 0.55;
	}

	.m-data[data-status='current'] {
		background: var(--accent-light);
	}

	.m-data[data-active='true'] {
		color: var(--text);
	}

	.m-empty {
		color: var(--text-accent);
		opacity: 0.4;
	}

	.talks-widget-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	.talks-widget-head h2 {
		margin: 0;
	}

	.talks-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}


	.calendar-embed {
		margin-top: 1rem;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--border);
		background: var(--surface);
	}

	.calendar-embed iframe {
		display: block;
		width: 100%;
		height: 36rem;
		border: 0;
	}

	/* Stack into one card: each quarter header followed by the programs running that quarter. */
	@media (max-width: 56rem) {
		.lede-row {
			flex-direction: column;
			align-items: stretch;
			gap: 1rem;
		}

		.year-switcher {
			justify-content: space-between;
		}

		.matrix {
			grid-template-columns: 1fr;
			grid-template-rows: none;
			grid-auto-flow: row;
		}

		.m-corner,
		.m-label,
		.m-data[data-active='false'] {
			display: none;
		}

		.m-name {
			display: block;
		}

		.m-data {
			justify-content: space-between;
			gap: 1rem;
		}
	}
</style>
