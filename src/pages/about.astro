---
import Layout from '../layouts/Layout.astro'
import { getEntry, render } from 'astro:content'

const constitutionEntry = await getEntry('constitution', 'constitution')
if (!constitutionEntry) {
	throw new Error('Missing constitution entry')
}

const { Content } = await render(constitutionEntry)
---

<Layout title="About - i2">
	<h1>About</h1>
	<p>
		interactive intelligence (i2) is the University of Washington's student-led NeuroAI
		education and research organization. We're a community of students learning, building, and
		researching at the intersection of artificial intelligence and neuroscience. Across our
		programs, members work on topics spanning deep learning, computational neuroscience,
		mechanistic interpretability, and the broader question of what intelligence is and how to
		build it.
	</p>
	<section class="prose">
		<Content />
	</section>
</Layout>
