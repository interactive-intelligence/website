---
import Layout from '../layouts/Layout.astro'
import LinkButton from '../components/LinkButton.astro'

const base = import.meta.env.BASE_URL
const prefixed = (path: string) => base.replace(/\/?$/, '/') + path.replace(/^\//, '')
---

<Layout
	title="About - i2"
	description="Learn about interactive intelligence (i2), the University of Washington's student-led NeuroAI education and research organization, its team, and its constitution."
>
	<h1>About</h1>
	<p>
		interactive intelligence (i2) is the University of Washington's student-led NeuroAI
		education and research organization. We're a community of students learning, building, and
		researching at the intersection of artificial intelligence and neuroscience. Across our
		programs, members work on topics spanning deep learning, computational neuroscience,
		mechanistic interpretability, and the broader question of what intelligence is and how to
		build it.
	</p>

	<div class="cards">
		<section>
			<h2>Team</h2>
			<p>
				i2 is run by a diverse team of student officers and supported by faculty advisors.
			</p>
			<LinkButton href={prefixed('/team')} variant="accent">Meet the team</LinkButton>
		</section>

		<section>
			<h2>Constitution</h2>
			<p>
				Our governance structure, membership policies, and officer roles are documented in
				our constitution.
			</p>
			<LinkButton href={prefixed('/constitution')} variant="accent">Read the constitution</LinkButton>
		</section>
	</div>
</Layout>

<style>
	.cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-top: 3rem;
	}

	.cards section {
		margin-top: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.cards section > * {
		margin: 0;
	}

	@media (max-width: 48rem) {
		.cards {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
	}
</style>
