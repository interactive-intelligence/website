---
import Layout from '../layouts/Layout.astro'
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import { getPublished } from '../lib/content'
import { websiteLabel } from '../lib/links'
import PersonCard from '../components/PersonCard.astro'

const members = await getPublished('team')

const roleOrder: Record<string, number> = {
	President: 0,
	Founder: 1,
	Advisor: 2,
	Officer: 3,
	Alumni: 4
}

const sorted = [...members].sort((a, b) => {
	const ra = roleOrder[a.data.role] ?? 99
	const rb = roleOrder[b.data.role] ?? 99
	if (ra !== rb) return ra - rb
	return a.data.name.localeCompare(b.data.name)
})

const alumniTier = (m: (typeof sorted)[number]) => {
	if (m.data.role === 'Founder') return 0
	if ((m.data.tags ?? []).includes('Founding Member')) return 1
	return 2
}

const active = sorted.filter((m) => m.data.active)
const alumni = sorted
	.filter((m) => !m.data.active)
	.sort((a, b) => {
		const ta = alumniTier(a)
		const tb = alumniTier(b)
		if (ta !== tb) return ta - tb
		return a.data.name.localeCompare(b.data.name)
	})

const activeWithBody = await Promise.all(
	active.map(async (m) => {
		const { Content } = await render(m)
		return { ...m, Content }
	})
)
---

<Layout
	title="Team - i2"
	description="Meet the student officers, faculty advisors, and alumni who run i2."
>
	<header class="page-header">
		<h1>Team</h1>
		<p class="lede">i2 is built by a diverse community of students, faculty, and alumni.</p>
	</header>

	<section class="active">
		<div class="grid">
			{
				activeWithBody.map(({ data, Content }) => (
					<PersonCard
						name={data.name}
						role={data.role}
						image={data.image}
						tags={data.tags}
						email={data.email}
						website={data.website}
					>
						<Content />
					</PersonCard>
				))
			}
		</div>
	</section>

	{
		alumni.length > 0 && (
			<section class="alumni">
				<h2 id="alumni">
					Alumni
					<a class="heading-anchor" href="#alumni" aria-hidden="true" tabindex="-1">
						#
					</a>
				</h2>
				<div class="alumni-grid">
					{alumni.map(({ data }) => (
						<article class="alum">
							{data.image && (
								<div class="alum-photo">
									<Image
										src={data.image}
										alt={data.name}
										sizes="(max-width: 40rem) 25vw, 12rem"
										loading="lazy"
									/>
								</div>
							)}
							<div class="alum-info">
								<h3>{data.name}</h3>
								{data.tags && data.tags.length > 0 && (
									<p class="alum-tags">{data.tags.join(' · ')}</p>
								)}
								<div class="alum-links">
									{data.email && (
										<a href={`mailto:${data.email}`}>{data.email}</a>
									)}
									{data.website && (
										<a href={data.website} target="_blank" rel="noopener">
											{websiteLabel(data.website)}
										</a>
									)}
								</div>
							</div>
						</article>
					))}
				</div>
			</section>
		)
	}
</Layout>

<style>
	section {
		margin-bottom: 5rem;
	}

	section h2 {
		margin-bottom: 1.5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
		gap: 1.5rem;
	}

	.alumni-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.alum {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.alum-photo {
		aspect-ratio: 1;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--surface);
	}

	.alum-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.alum-info h3 {
		font-size: 1rem;
		margin: 0 0 0.25rem;
		font-weight: 600;
	}

	.alum-tags {
		font-size: 0.75rem;
		color: var(--text-accent);
		margin: 0 0 0.25rem;
	}

	.alum-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-size: 0.75rem;
	}

	.alum-links a {
		overflow-wrap: anywhere;
		color: var(--text-accent);
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-underline-offset: 2px;
		transition: text-decoration-color var(--duration-fast) var(--ease);
	}

	.alum-links a:hover {
		text-decoration-color: var(--text-accent);
	}

	@media (max-width: 56rem) {
		.alumni-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 30rem) {
		.alumni-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
