---
import { Picture } from 'astro:assets'
import { render } from 'astro:content'
import { getPublished } from '../../lib/content'
import { getFeed } from '../../lib/feed'
import { TIME_ZONE } from '../../lib/dates'
import { Icon } from 'astro-icon/components'
import Layout from '../../layouts/Layout.astro'
import BackButton from '../../components/BackButton.astro'
import TalkCard from '../../components/TalkCard.astro'
import AnnouncementList from '../../components/AnnouncementList.astro'
import LinkButton from '../../components/LinkButton.astro'
import { discordUrl } from '../../lib/links'

export async function getStaticPaths() {
	const initiatives = await getPublished('initiatives')
	return initiatives
		.filter((entry) => !entry.data.external_url)
		.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)

const [schedules, talks, updates] = await Promise.all([
	getPublished('schedule'),
	getPublished('talks'),
	getFeed({ initiative: entry.id, limit: 4 })
])

const today = new Date()

// Every quarter across all schedule years, annotated with whether this
// initiative runs in it (and when it meets).
const quarters = schedules
	.flatMap((s) =>
		s.data.quarters.map((q) => {
			const slot = q.initiatives.find((i) => i.id === entry.id)
			return { ...q, year: s.data.year, active: Boolean(slot), time: slot?.time }
		})
	)
	.sort((a, b) => a.start.getTime() - b.start.getTime())

const current = quarters.find((q) => today >= q.start && today <= q.end)
const running = Boolean(current?.active)
const next = quarters.find((q) => q.start > today && q.active)
const focus = running ? current : next

const dateFmt = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	timeZone: TIME_ZONE
})

const isTalks = entry.id === 'talks'
const upcomingTalks = talks
	.filter((t) => t.data.date.getTime() >= today.getTime())
	.sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
const pastTalks = talks
	.filter((t) => t.data.date.getTime() < today.getTime())
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Layout
	title={`${entry.data.name} - i2`}
	description={entry.data.short_description}
	image={entry.data.photo}
>
	<BackButton href="/initiatives" label="All initiatives" />

	<header class="hero">
		<div class="hero-text">
			<h1>{entry.data.name}</h1>
			<p class="lede">{entry.data.long_description}</p>
			{
				focus && (
					<ul class="details">
						<li>
							<Icon aria-hidden="true" name="mingcute:calendar-line" />
							{focus.name}
							<span class="muted">
								{running
									? '· running now'
									: `· starts ${dateFmt.format(focus.start)}`}
							</span>
						</li>
						<li>
							<Icon aria-hidden="true" name="mingcute:time-line" />
							{focus.time && focus.time !== 'TBD'
								? `Meets ${focus.time}`
								: 'Meeting time TBD'}
						</li>
					</ul>
				)
			}
			{
				entry.data.form_url && (
					<div class="actions">
						<LinkButton href={entry.data.form_url}>{entry.data.form_label}</LinkButton>
					</div>
				)
			}
		</div>
		<div class="hero-photo">
			<Picture
				src={entry.data.photo}
				formats={['avif', 'webp']}
				alt={entry.data.name}
				sizes="(max-width: 48rem) 100vw, 35rem"
			/>
		</div>
	</header>

	<!-- <hr /> -->

	<section class="cta">
		<div class="cta-text">
			<h2>Get involved</h2>
			<p>
				{
					entry.data.form_url
						? `Applications are open. Have questions? Ask us on Discord.`
						: `Join our Discord for ${entry.data.name} announcements, meeting times, and how to take part.`
				}
			</p>
		</div>
		<div class="actions">
			{
				entry.data.form_url && (
					<LinkButton href={entry.data.form_url}>{entry.data.form_label}</LinkButton>
				)
			}
			<LinkButton href={discordUrl} variant={entry.data.form_url ? 'surface' : 'primary'}>
				<Icon aria-hidden="true" name="mingcute:discord-line" />
				Join Discord
			</LinkButton>
		</div>
	</section>

	<section class="prose">
		<Content />
	</section>

	{
		isTalks && (
			<section>
				<h2>Upcoming talks</h2>
				{upcomingTalks.length > 0 ? (
					<ul class="talk-list">
						{upcomingTalks.map((t) => (
							<li>
								<TalkCard talk={t} />
							</li>
						))}
					</ul>
				) : (
					<p>No talks currently scheduled. Check back as new speakers are confirmed.</p>
				)}
				{pastTalks.length > 0 && (
					<>
						<h2 class="past-heading">Past talks</h2>
						<ul class="talk-list">
							{pastTalks.map((t) => (
								<li>
									<TalkCard talk={t} />
								</li>
							))}
						</ul>
					</>
				)}
			</section>
		)
	}

	{
		updates.length > 0 && (
			<section>
				<div class="section-head">
					<h2>Updates</h2>
					<a href="/announcements" class="link-arrow">
						All announcements <Icon aria-hidden="true" name="mingcute:arrow-right-line" class="arrow-right" />
					</a>
				</div>
				<AnnouncementList items={updates} headingLevel="h3" />
			</section>
		)
	}
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 3rem;
		align-items: center;
	}

	.hero h1 {
		font-size: 3rem;
		margin-bottom: 1.5rem;
	}

	.lede {
		font-size: 1.125rem;
		margin-bottom: 2rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.hero-photo {
		aspect-ratio: 4 / 3;
		border-radius: var(--radius-lg);
		overflow: hidden;
	}

	.hero-photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.details {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		font-weight: 500;
	}

	.details li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
	}

	.details [data-icon] {
		color: var(--text-accent);
		font-size: 1.125rem;
	}

	.muted {
		color: var(--text-accent);
		font-weight: 400;
	}

	hr {
		border: 0;
		border-top: 1px solid var(--rule);
		margin: 2.5rem 0 0;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.talk-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.talk-list li {
		margin: 0;
	}

	.past-heading {
		margin-top: 2rem;
	}

	.cta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 3rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
	}

	.cta h2 {
		font-size: 1.5rem;
	}

	.cta p {
		margin: 0;
	}

	.cta .actions {
		flex-shrink: 0;
	}

	.cta .actions [data-icon] {
		font-size: 1.5rem;
	}

	@media (max-width: 48rem) {
		.hero {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.hero h1 {
			font-size: 2.5rem;
		}

		.hero-photo {
			aspect-ratio: 16 / 9;
		}

		.cta {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}
	}
</style>
