---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allTalks = await getCollection("talks");
const now = new Date();
const upcoming = allTalks.filter((t) => t.data.date >= now);
const past = allTalks.filter((t) => t.data.date < now);
---

<Layout title="Talks - i2">
  <h1>Talks</h1>

  <section>
    <h2>Upcoming</h2>
    {upcoming.length > 0 ? (
      <ul>
        {upcoming.map((talk) => (
          <li>
            <strong>{talk.data.title}</strong>
            — {talk.data.date.toLocaleDateString()}
            <p>{talk.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p>No upcoming talks scheduled.</p>
    )}
  </section>

  <section>
    <h2>Past</h2>
    {past.length > 0 ? (
      <ul>
        {past.map((talk) => (
          <li>
            <strong>{talk.data.title}</strong>
            — {talk.data.date.toLocaleDateString()}
            <p>{talk.data.description}</p>
            {talk.data.youtubeUrl && (
              <p><a href={talk.data.youtubeUrl}>Watch recording</a></p>
            )}
          </li>
        ))}
      </ul>
    ) : (
      <p>No past talks yet.</p>
    )}
  </section>
</Layout>
