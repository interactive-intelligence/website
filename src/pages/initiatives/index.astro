      <p>Introductory course on NeuroAI.</p>
    </li>
    <li>
      <a href={`${base}initiatives/dsi`}>Data Science Initiative</a>
      <p>Quarterly data science projects.</p>
    </li>
    <li>
      <a href={`${base}initiatives/fellows`}>Fellows</a>
      <p>Research fellowship program.</p>
    </li>
    <li>
      <a href={`${base}initiatives/research-room`}>Research Room</a>
      <p>Collaborative research space.</p>
    </li>
    <li>
      <a href={`${base}initiatives/talks`}>Talks</a>
      <p>Speaker series and presentations.</p>
    </li>
  </ul>
</Layout>
