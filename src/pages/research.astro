---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const base = import.meta.env.BASE_URL;

const publications = await getCollection("publications");
---

<Layout title="Research - i2">
  <h1>Research</h1>
  <p>Publications and projects produced by i2.</p>

  <section>
    <h2 id="publications">Publications<a class="heading-anchor" href="#publications" aria-label="Link to section">#</a></h2>
    <ul>
      {publications.map((pub) => (
        <li>
          {pub.data.url ? (
            <a href={pub.data.url}>{pub.data.title}</a>
          ) : (
            <span>{pub.data.title}</span>
          )}
          — {pub.data.authors.join(", ")}
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 id="related-programs">Related Programs<a class="heading-anchor" href="#related-programs" aria-label="Link to section">#</a></h2>
    <ul>
      <li><a href={`${base}initiatives/research-room`}>Research Room</a></li>
      <li><a href={`${base}initiatives/fellows`}>Fellows</a></li>
    </ul>
  </section>
</Layout>
