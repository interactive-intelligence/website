---
import { render } from 'astro:content'
import { getPublished } from '../../lib/content'
import { TIME_ZONE } from '../../lib/dates'
import ArticleLayout from '../../layouts/ArticleLayout.astro'

export async function getStaticPaths() {
	const talks = await getPublished('talks')
	return talks.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)

const dateFmt = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZoneName: 'short',
	timeZone: TIME_ZONE
})

const isPast = entry.data.date.getTime() < Date.now()

const description =
	entry.data.summary ?? `${entry.data.speaker} gives an i2 Talk at the University of Washington.`

const eventSchema = {
	'@context': 'https://schema.org',
	'@type': 'Event',
	name: entry.data.title,
	description,
	startDate: entry.data.date.toISOString(),
	eventStatus: 'https://schema.org/EventScheduled',
	eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
	...(entry.data.location && {
		location: {
			'@type': 'Place',
			name: entry.data.location,
			address: 'University of Washington, Seattle, WA'
		}
	}),
	performer: { '@type': 'Person', name: entry.data.speaker },
	organizer: {
		'@type': 'Organization',
		name: 'interactive intelligence',
		url: Astro.site!.toString()
	},
	isAccessibleForFree: true,
	...(entry.data.youtubeUrl && {
		recordedIn: {
			'@type': 'VideoObject',
			name: `${entry.data.title} — recording`,
			url: entry.data.youtubeUrl
		}
	})
}

const youtubeEmbed = (url: string | undefined): string | null => {
	if (!url) return null
	try {
		const u = new URL(url)
		let id: string | null = null
		if (u.hostname.endsWith('youtu.be')) {
			id = u.pathname.slice(1)
		} else if (u.searchParams.has('v')) {
			id = u.searchParams.get('v')
		} else if (u.pathname.startsWith('/embed/')) {
			id = u.pathname.slice('/embed/'.length)
		}
		return id ? `https://www.youtube.com/embed/${id}` : null
	} catch {
		return null
	}
}

const embedSrc = youtubeEmbed(entry.data.youtubeUrl)
---

<ArticleLayout
	title={entry.data.title}
	description={description}
	summary={entry.data.summary}
	published={entry.data.posted}
>
	<script
		slot="head"
		is:inline
		type="application/ld+json"
		set:html={JSON.stringify(eventSchema)}
	/>
	<Fragment slot="details">
		<div>
			<dt class="label">Speaker</dt>
			<dd>{entry.data.speaker}</dd>
		</div>
		<div>
			<dt class="label">{isPast ? 'Held on' : 'When'}</dt>
			<dd>
				<time datetime={entry.data.date.toISOString()}>
					{dateFmt.format(entry.data.date)}
				</time>
			</dd>
		</div>
		{
			entry.data.location && (
				<div>
					<dt class="label">Where</dt>
					<dd>{entry.data.location}</dd>
				</div>
			)
		}
	</Fragment>

	{
		embedSrc && (
			<div class="video">
				<iframe
					src={embedSrc}
					title={`${entry.data.title} — recording`}
					loading="lazy"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
					allowfullscreen
				/>
			</div>
		)
	}

	<section class="prose">
		<Content />
	</section>
</ArticleLayout>

<style>
	.video {
		margin: 0 0 2rem;
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--black);
	}

	.video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
