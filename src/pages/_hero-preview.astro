---
// TEMPORARY preview page for comparing hero-image treatments.
// Delete once a direction is chosen. Visit /website/hero-preview
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import hero1 from '../assets/hero-1.jpg';
import hero2 from '../assets/hero-2.jpg';
import hero3 from '../assets/hero-3.jpg';
import hero4 from '../assets/IMG_3286.jpg';

const imgs = [hero1, hero2, hero3, hero4];
const fmts = ['avif', 'webp'] as const;

const lede =
	"i2 is UW's student-led NeuroAI education and research organization. We aim to create a community of project-driven, outcome-oriented students interested in the intersections of artificial intelligence, neuroscience, and philosophy. We are interested in how machines can learn like humans.";

// #8 carousel: repeat the set so there's always something to rotate in
const carImages = Array.from({ length: 5 }, () => imgs).flat();
---

<Layout title="hero preview">
	<p class="page-title">hero treatments — each shown in the real homepage layout</p>

	<!-- 1. BENTO GRID + hover zoom -->
	<section class="demo">
		<p class="label">1 · bento grid + hover zoom <span>— asymmetric grid, gaps, individual rounding. hover an image to zoom.</span></p>
		<h1 class="hero">
			<span>interactive intelligence</span>
			<span>(i2)</span>
		</h1>
		<div class="bento">
			<div class="cell cell-a"><Picture src={imgs[0]} formats={fmts} alt="" /></div>
			<div class="cell cell-d"><Picture src={imgs[3]} formats={fmts} alt="" /></div>
			<div class="cell cell-b"><Picture src={imgs[1]} formats={fmts} alt="" /></div>
			<div class="cell cell-c"><Picture src={imgs[2]} formats={fmts} alt="" /></div>
		</div>
		<p class="lede">{lede}</p>
	</section>

	<!-- 2. EXPANDING STRIPS (hover to grow) -->
	<section class="demo">
		<p class="label">2 · expanding strips <span>— equal strips that grow on hover, neighbors shrink. no JS.</span></p>
		<h1 class="hero">
			<span>interactive intelligence</span>
			<span>(i2)</span>
		</h1>
		<div class="strips">
			{imgs.map((img) => (
				<div class="strip"><Picture src={img} formats={fmts} alt="" /></div>
			))}
		</div>
		<p class="lede">{lede}</p>
	</section>

	<!-- 3. MARQUEE -->
	<section class="demo">
		<p class="label">3 · marquee <span>— slowly scrolling band that bleeds off both edges. pauses on hover.</span></p>
		<h1 class="hero">
			<span>interactive intelligence</span>
			<span>(i2)</span>
		</h1>
		<div class="marquee">
			<div class="marquee-track">
				{[...imgs, ...imgs].map((img) => (
					<div class="marquee-item"><Picture src={img} formats={fmts} alt="" /></div>
				))}
			</div>
		</div>
		<p class="lede">{lede}</p>
	</section>

	<!-- 5. POLAROID STACK -->
	<section class="demo demo-stack">
		<p class="label">5 · tilted polaroid stack <span>— overlapping, slightly rotated photos. hover to straighten & lift. text below photos.</span></p>
		<div class="stack">
			{imgs.map((img, i) => (
				<div class="stack-card" style={`--i:${i}`}><Picture src={img} formats={fmts} alt="" /></div>
			))}
		</div>
		<h1 class="hero">
			<span>interactive intelligence</span>
			<span>(i2)</span>
		</h1>
		<p class="lede">{lede}</p>
	</section>

	<!-- 6. VERTICAL COLUMNS -->
	<section class="demo">
		<p class="label">6 · dual vertical-column marquee <span>— columns scroll in opposite directions. pauses on hover.</span></p>
		<h1 class="hero">
			<span>interactive intelligence</span>
			<span>(i2)</span>
		</h1>
		<div class="columns">
			{[0, 1, 2].map((col) => (
				<div class={`col ${col % 2 ? 'col-down' : 'col-up'}`}>
					<div class="col-track">
						{[...imgs, ...imgs].map((img) => (
							<div class="col-item"><Picture src={img} formats={fmts} alt="" /></div>
						))}
					</div>
				</div>
			))}
		</div>
		<p class="lede">{lede}</p>
	</section>

	<!-- 7. SPOTLIGHT GRID -->
	<section class="demo">
		<p class="label">7 · spotlight grid <span>— hover a tile to expand it; the rest dim.</span></p>
		<h1 class="hero">
			<span>interactive intelligence</span>
			<span>(i2)</span>
		</h1>
		<div class="spotlight">
			{[...imgs, ...imgs].map((img) => (
				<div class="spot"><Picture src={img} formats={fmts} alt="" /></div>
			))}
		</div>
		<p class="lede">{lede}</p>
	</section>

	<!-- 8. WIDENING CAROUSEL (hybrid of #2 + carousel) -->
	<section class="demo">
		<p class="label">8 · widening carousel <span>— three across with a wide center; auto-rotates new images into the middle. pauses on hover.</span></p>
		<h1 class="hero">
			<span>interactive intelligence</span>
			<span>(i2)</span>
		</h1>
		<div class="carousel" data-count={imgs.length}>
			<div class="car-track">
				{carImages.map((img) => (
					<div class="car-slide"><Picture src={img} formats={fmts} alt="" /></div>
				))}
			</div>
		</div>
		<p class="lede">{lede}</p>
	</section>
</Layout>

<style>
	.page-title {
		color: var(--text-accent);
		font-size: 0.9rem;
		margin-bottom: 3rem;
	}

	/* one preview = the real homepage hero layout */
	.demo {
		margin-top: 6rem;
		padding-top: 3rem;
		border-top: 1px solid var(--rule);
	}
	.demo:first-of-type {
		margin-top: 0;
		padding-top: 0;
		border-top: 0;
	}
	.label {
		margin: 0 0 2rem;
		font-size: 0.875rem;
		font-weight: 600;
	}
	.label span {
		font-weight: 400;
		color: var(--text-accent);
	}

	/* mirrors index.astro */
	.hero {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 2rem;
		font-size: 4rem;
		line-height: 1;
		letter-spacing: -0.04em;
		margin: 0;
	}
	.lede {
		margin-top: 2rem;
		font-size: 1.125rem;
	}
	/* the image treatment sits between hero and lede, like .hero-images */
	.demo .hero + div {
		margin-top: 1rem;
	}
	/* #5 flips the order: photos first, then the hero text */
	.demo-stack .hero {
		margin-top: 1rem;
	}
	:global(.bento img),
	:global(.strip img),
	:global(.marquee-item img),
	:global(.stack-card img),
	:global(.col-item img),
	:global(.spot img),
	:global(.car-slide img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* 1. BENTO */
	.bento {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		grid-template-rows: repeat(2, 9rem);
		gap: 0.5rem;
		height: 18.5rem;
	}
	.cell {
		overflow: hidden;
		border-radius: var(--radius);
	}
	.cell :global(img) {
		transition: transform var(--duration-slow) var(--ease);
	}
	.cell:hover :global(img) {
		transform: scale(1.06);
	}
	.cell-a {
		grid-row: span 2;
	}
	.cell-d {
		grid-column: span 2;
	}

	/* 2. EXPANDING STRIPS */
	.strips {
		display: flex;
		gap: 0.5rem;
		height: 18rem;
	}
	.strip {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		border-radius: var(--radius);
		transition: flex var(--duration-slow) var(--ease);
	}
	.strips:hover .strip {
		flex: 0.7;
	}
	.strips .strip:hover {
		flex: 2.4;
	}

	/* 3. MARQUEE */
	.marquee {
		overflow: hidden;
		border-radius: var(--radius-lg);
		--gap: 0.5rem;
	}
	.marquee-track {
		display: flex;
		gap: var(--gap);
		width: max-content;
		animation: scroll 28s linear infinite;
	}
	.marquee:hover .marquee-track {
		animation-play-state: paused;
	}
	.marquee-item {
		width: 22rem;
		height: 16rem;
		flex: 0 0 auto;
		border-radius: var(--radius);
		overflow: hidden;
	}
	@keyframes scroll {
		to {
			/* shift by half (one full set of 4 items + their gaps) */
			transform: translateX(calc(-50% - var(--gap) / 2));
		}
	}

	/* 5. POLAROID STACK */
	.stack {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 24rem;
	}
	.stack-card {
		flex: 1 1 0;
		min-width: 0;
		height: 18rem;
		margin-inline: -2.5rem;
		border-radius: var(--radius);
		overflow: hidden;
		box-shadow: var(--shadow);
		transform: rotate(calc((var(--i) - 1.5) * 4deg)) translateY(calc(var(--i) * -0.25rem));
		transition: transform var(--duration-slow) var(--ease);
	}
	.stack-card:first-child {
		margin-left: 0;
	}
	.stack-card:last-child {
		margin-right: 0;
	}
	.stack-card:hover {
		transform: rotate(0deg) translateY(-1rem) scale(1.04);
		z-index: 2;
	}

	/* 6. VERTICAL COLUMNS */
	.columns {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
		height: 20rem;
		overflow: hidden;
		border-radius: var(--radius-lg);
	}
	.col {
		overflow: hidden;
	}
	.col-track {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.col-up .col-track {
		animation: scroll-up 30s linear infinite;
	}
	.col-down .col-track {
		animation: scroll-up 30s linear infinite reverse;
	}
	.columns:hover .col-track {
		animation-play-state: paused;
	}
	.col-item {
		height: 12rem;
		flex: 0 0 auto;
		border-radius: var(--radius);
		overflow: hidden;
	}
	@keyframes scroll-up {
		to {
			transform: translateY(calc(-50% - 0.25rem));
		}
	}

	/* 7. SPOTLIGHT GRID */
	.spotlight {
		display: flex;
		gap: 0.5rem;
		height: 16rem;
	}
	.spot {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		border-radius: var(--radius);
		transition:
			flex var(--duration-slow) var(--ease),
			opacity var(--duration) var(--ease);
	}
	.spotlight:hover .spot {
		opacity: 0.45;
		flex: 0.6;
	}
	.spotlight .spot:hover {
		opacity: 1;
		flex: 3;
	}

	/* 8. WIDENING CAROUSEL */
	.carousel {
		overflow: hidden;
		height: 18rem;
	}
	.car-track {
		display: flex;
		gap: 0.5rem;
		height: 100%;
		transition: transform 600ms var(--ease);
		will-change: transform;
	}
	.car-slide {
		flex: 0 0 auto;
		width: var(--narrow, 14rem);
		height: 100%;
		border-radius: var(--radius);
		overflow: hidden;
		transition: width 600ms var(--ease);
	}
	.car-slide.is-active {
		width: var(--wide, 26rem);
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track,
		.col-track {
			animation: none;
		}
	}

	@media (max-width: 48rem) {
		.hero {
			font-size: 2.5rem;
		}
	}
</style>

<script>
	// #8 widening carousel: keep the active slide centered and wide,
	// auto-advance so a new image grows into the middle.
	const car = document.querySelector<HTMLElement>('.carousel');
	if (car && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const track = car.querySelector<HTMLElement>('.car-track')!;
		const slides = Array.from(track.children) as HTMLElement[];
		const N = Number(car.dataset.count); // base image count before looping
		const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
		const GAP = 0.5 * rem;
		let idx = N; // start one full set in so there's room on both sides
		let NARROW = 0;
		let WIDE = 0;

		// size slides so exactly three (narrow–wide–narrow) fill the container
		function measure() {
			const w = car!.clientWidth;
			WIDE = w * 0.58;
			NARROW = (w - WIDE - 2 * GAP) / 2;
			car!.style.setProperty('--narrow', `${NARROW}px`);
			car!.style.setProperty('--wide', `${WIDE}px`);
		}

		function place(animate: boolean) {
			if (!animate) track.style.transition = 'none';
			slides.forEach((s, i) => s.classList.toggle('is-active', i === idx));
			// every slide before the active one is narrow, so its left edge is predictable
			const x = car!.clientWidth / 2 - (idx * (NARROW + GAP) + WIDE / 2);
			track.style.transform = `translateX(${x}px)`;
			if (!animate) {
				track.getBoundingClientRect(); // force reflow before re-enabling transition
				track.style.transition = '';
			}
		}

		measure();

		place(false);
		window.addEventListener('resize', () => {
			measure();
			place(false);
		});

		const INTERVAL = 3200;
		let timer = setInterval(advance, INTERVAL);

		function advance() {
			idx += 1;
			place(true);
			// once we near the end of the looped list, snap back a set with no animation
			if (idx >= 3 * N) {
				setTimeout(() => {
					idx -= N;
					place(false);
				}, 650);
			}
		}

		car.addEventListener('mouseenter', () => clearInterval(timer));
		car.addEventListener('mouseleave', () => {
			timer = setInterval(advance, INTERVAL);
		});
	}
</script>
