---
import logoRaw from '../assets/i2logo.svg?raw'

const base = import.meta.env.BASE_URL
const prefixed = (path: string) => base.replace(/\/?$/, '/') + path.replace(/^\//, '')

const links = [
	{ href: '/about', label: 'About' },
	{ href: '/team', label: 'Team' },
	{ href: '/constitution', label: 'Constitution' },
	{ href: '/schedule', label: 'Schedule' },
	{ href: '/announcements', label: 'Announcements' },
	{ href: '/initiatives', label: 'Initiatives' },
	{ href: '/join', label: 'Join Us' }
]

const socials = [
	{ href: 'https://discord.gg/Ph8njzHedC', label: 'Discord' },
	{ href: 'https://www.instagram.com/uw_i2/', label: 'Instagram' },
	{ href: 'https://www.youtube.com/channel/UCnOSBig3HbEHFUi2HBA7EtA', label: 'YouTube' },
	{ href: 'https://x.com/InteractiveInt9', label: 'X (Twitter)' },
	{ href: 'https://github.com/interactive-intelligence', label: 'GitHub' }
]

const resources = [{ href: 'https://grimoire.uw-i2.org/', label: 'Textbook' }]
---

<footer>
	<div class="inner">
		<div class="brand">
			<a href={base} class="logo" aria-label="Home">
				<Fragment set:html={logoRaw} />
			</a>
			<p class="tag">UW's student-led NeuroAI education and research organization.</p>
			<a class="email" href="mailto:interintel@uw.edu"> interintel@uw.edu </a>
		</div>

		<div class="col">
			<div class="label">Site</div>
			<ul>
				{
					links.map(({ href, label }) => (
						<li>
							<a href={prefixed(href)}>{label}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="col">
			<div class="label">Follow</div>
			<ul>
				{
					socials.map(({ href, label }) => (
						<li>
							<a href={href} target="_blank" rel="noopener noreferrer">
								{label}
							</a>
						</li>
					))
				}
			</ul>

			<div class="label">Learn</div>
			<ul>
				{
					resources.map(({ href, label }) => (
						<li>
							<a href={href} target="_blank" rel="noopener noreferrer">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<svg
		class="bigname"
		viewBox="0 0 1000 110"
		preserveAspectRatio="xMidYMid meet"
		aria-hidden="true"
	>
		<defs>
			<linearGradient
				id="bigname-grad"
				gradientUnits="userSpaceOnUse"
				x1="0"
				y1="0"
				x2="1200"
				y2="0"
				spreadMethod="repeat"
			>
				<stop class="g-edge" offset="10%"></stop>
				<stop class="g-mid" offset="50%"></stop>
				<stop class="g-edge" offset="90%"></stop>
				<animateTransform
					attributeName="gradientTransform"
					type="translate"
					from="0 0"
					to="1200 0"
					dur="7s"
					repeatCount="indefinite"></animateTransform>
			</linearGradient>
		</defs>
		<text x="-3" y="90" textLength="1000" lengthAdjust="spacingAndGlyphs"
			>interactive intelligence</text
		>
	</svg>

	<div class="meta">
		<span>© {new Date().getFullYear()} interactive intelligence</span>
		<span>Seattle, WA</span>
	</div>
</footer>

<style>
	footer {
		max-width: var(--container);
		margin: 4rem auto 0;
		padding: 0 1.5rem 2rem;
	}

	.inner {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 3rem;
		align-items: start;
		padding: 2.5rem 0 2rem;
		border-top: 1px solid var(--rule);
	}

	.brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1rem;
		max-width: 22rem;
	}

	.logo {
		display: inline-block;
		width: 4rem;
		height: 4rem;
		padding: 0.25rem;
		background: var(--logo-bg);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.logo :global(svg) {
		width: 100%;
		height: 100%;
	}

	.email {
		color: var(--text-accent);
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--rule);
		text-underline-offset: 2px;
		transition: text-decoration-color var(--duration-fast) var(--ease);
	}

	.email:hover {
		text-decoration-color: var(--text-accent);
	}

	.tag {
		font-size: 1rem;
		margin: 0;
		line-height: 1.5;
	}

	.label {
		font-size: 0.875rem;
		color: var(--text-accent);
		margin-bottom: 0.75rem;
	}

	.col ul + .label {
		margin-top: 2.5rem;
	}

	.col ul {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.col li {
		margin-top: 0;
	}

	.col a {
		display: inline-block;
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: 3px;
		transition:
			text-decoration-color var(--duration-fast) var(--ease),
			color var(--duration-fast) var(--ease);
	}

	.col a:hover {
		color: var(--text-accent);
		text-decoration-color: var(--text-accent);
	}

	.bigname {
		display: block;
		width: 100%;
		overflow: visible;
	}

	.bigname text {
		font-family: inherit;
		font-weight: 700;
		font-size: 96px;
		letter-spacing: -0.04em;
		fill: url(#bigname-grad);
		stroke: var(--border-accent-light);
		stroke-width: 2px;
		paint-order: stroke;
	}

	.bigname .g-edge {
		stop-color: var(--surface);
	}

	.bigname .g-mid {
		stop-color: var(--accent-light);
	}

	.meta {
		display: flex;
		justify-content: space-between;
		font-size: 0.875rem;
		color: var(--text-accent);
	}

	@media (max-width: 48rem) {
		.inner {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}

		.brand {
			grid-column: 1 / -1;
		}
	}
</style>
