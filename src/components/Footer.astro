---
import logoRaw from '../assets/i2logo.svg?raw'

const base = import.meta.env.BASE_URL
const prefixed = (path: string) => base.replace(/\/?$/, '/') + path.replace(/^\//, '')

const links = [
	{ href: '/about', label: 'About' },
	{ href: '/schedule', label: 'Schedule' },
	{ href: '/team', label: 'Team' },
	{ href: '/research', label: 'Research' },
	{ href: '/initiatives', label: 'Initiatives' },
	{ href: '/join', label: 'Join Us' }
]

const socials = [
	{ href: 'https://discord.gg/QeGDNYVh', label: 'Discord' },
	{ href: 'https://www.instagram.com/uw_i2/', label: 'Instagram' },
	{ href: 'https://www.youtube.com/channel/UCnOSBig3HbEHFUi2HBA7EtA', label: 'YouTube' },
	{ href: 'https://twitter.com/InteractiveInt9', label: 'Twitter' },
	{ href: 'https://linktr.ee/interactive_intelligence', label: 'LinkTree' }
]
---

<footer>
	<div class="inner">
		<div class="brand">
			<a href={base} class="logo" aria-label="Home">
				<Fragment set:html={logoRaw} />
			</a>
			<!-- <div class="name">interactive intelligence</div> -->

			<div class="label">Get in touch</div>
			<a class="email" href="mailto:interintel@uw.edu">interintel@uw.edu</a>
			<!-- <div class="tag">UW's student-led NeuroAI organization</div> -->
		</div>

		<div class="col"></div>

		<div class="col">
			<div class="label">Site</div>
			<ul>
				{
					links.map(({ href, label }) => (
						<li>
							<a href={prefixed(href)}>{label}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="col">
			<div class="label">Follow</div>
			<ul>
				{
					socials.map(({ href, label }) => (
						<li>
							<a href={href} target="_blank" rel="noopener">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<svg
		class="bigname"
		viewBox="0 0 1000 140"
		preserveAspectRatio="xMidYMid meet"
		aria-hidden="true"
	>
		<defs>
			<linearGradient
				id="bigname-grad"
				gradientUnits="userSpaceOnUse"
				x1="0"
				y1="0"
				x2="1200"
				y2="0"
				spreadMethod="repeat"
			>
				<stop class="g-edge" offset="0%"></stop>
				<stop class="g-mid" offset="50%"></stop>
				<stop class="g-edge" offset="100%"></stop>
				<animateTransform
					attributeName="gradientTransform"
					type="translate"
					from="0 0"
					to="1200 0"
					dur="4s"
					repeatCount="indefinite"></animateTransform>
			</linearGradient>
		</defs>
		<text x="-3" y="115" textLength="1000" lengthAdjust="spacingAndGlyphs"
			>interactive intelligence</text
		>
	</svg>

	<div class="meta">
		<span>© {new Date().getFullYear()} interactive intelligence</span>
		<span>Seattle, WA</span>
	</div>
</footer>

<style>
	footer {
		max-width: var(--container);
		margin: 4rem auto 0;
		padding: 0 1.5rem 2rem;
	}

	.inner {
		display: grid;
		grid-template-columns: 1.75fr 1fr 1fr 0.5fr;
		gap: 2.5rem;
		align-items: start;
		padding: 2rem 0;
		border-top: 1px solid var(--rule);
	}

	.logo {
		display: inline-block;
		width: 4rem;
		height: 4rem;
		padding: 0.25rem;
		background: var(--logo-tile);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.logo :global(svg) {
		width: 100%;
		height: 100%;
	}

	.name {
		font-size: 2.5rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.02em;
		margin: 0.5rem 0;
	}

	.tag {
		font-size: 0.875rem;
		color: var(--text-accent);
	}

	.label {
		font-size: 0.875rem;
		color: var(--text-accent);
		margin-bottom: 0.5rem;
	}

	.col ul {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
	}

	.col li {
		margin-top: 0;
	}

	.col a {
		font-size: 0.95rem;
	}

	.col a:hover {
		color: var(--text-accent);
	}

	.email {
		font-weight: 500;
	}

	.email:hover {
		color: var(--text-accent);
	}

	.bigname {
		display: block;
		width: 100%;
		overflow: visible;
	}

	.bigname text {
		font-family: inherit;
		font-weight: 700;
		font-size: 96px;
		letter-spacing: -0.04em;
		fill: url(#bigname-grad);
		stroke: var(--text-accent);
		stroke-width: 2px;
		paint-order: stroke;
	}

	.bigname .g-edge {
		stop-color: var(--surface);
	}

	.bigname .g-mid {
		stop-color: var(--accent-light);
	}

	@media (prefers-reduced-motion: reduce) {
		.bigname animateTransform {
			display: none;
		}
	}

	.meta {
		display: flex;
		justify-content: space-between;
		font-size: 0.875rem;
		color: var(--text-accent);
	}
</style>
