---
import LinkButton from './LinkButton.astro'
import { closesAttr, linksFor, type Link } from '../lib/content'
import { courseHref } from '../lib/course'

interface InitiativeItem {
	id: string
	data: {
		name: string
		short_description: string
		external_url?: string
	}
}

interface Props {
	items: InitiativeItem[]
	// Open links (see getOpenLinks); those tagged with an initiative become its buttons.
	links?: Link[]
}

const { items, links = [] } = Astro.props

const learnMoreHref = (item: InitiativeItem) =>
	item.data.external_url ?? `/initiatives/${item.id}`

// With no sign-up open, the Intro Course links to the course homepage instead.
const showCourseHome = (id: string) => id === 'intro-course' && linksFor(links, id).length === 0
---

<div class="accordion">
	{
		items.map((item, i) => (
			<details open={i === 0}>
				<summary>
					<span class="num">{String(i + 1).padStart(2, '0')}</span>
					<h3 class="title">{item.data.name}</h3>
					<span class="indicator" aria-hidden="true" />
				</summary>
				<div class="panel">
					<div class="body">
						<p>{item.data.short_description}</p>
						<div class="actions">
							<LinkButton
								href={learnMoreHref(item)}
								variant="accent"
								aria-label={`Learn more about ${item.data.name}`}
							>
								Learn More
							</LinkButton>
							{linksFor(links, item.id).map((link) => (
								<LinkButton href={link.data.url} data-closes={closesAttr(link)}>
									{link.data.title}
								</LinkButton>
							))}
							{showCourseHome(item.id) && (
								<LinkButton href={courseHref}>Course homepage</LinkButton>
							)}
						</div>
					</div>
				</div>
			</details>
		))
	}
</div>

<script>
	const accordions = document.querySelectorAll('.accordion')

	const setExpandedState = (item: HTMLDetailsElement, panel: HTMLElement, expanded: boolean) => {
		item.dataset.expanded = String(expanded)
		panel.style.height = expanded ? 'auto' : '0px'
	}

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

	const animatePanel = (item: HTMLDetailsElement, panel: HTMLElement, expand: boolean) => {
		if (reducedMotion.matches) {
			item.open = expand
			setExpandedState(item, panel, expand)
			return
		}

		item.dataset.animating = 'true'
		panel.style.height = `${panel.offsetHeight}px`
		panel.offsetHeight

		if (expand) {
			item.open = true
			item.dataset.expanded = 'true'
		}

		requestAnimationFrame(() => {
			panel.style.height = expand ? `${panel.scrollHeight}px` : '0px'
		})

		const onTransitionEnd = (event: TransitionEvent) => {
			if (event.propertyName !== 'height') return

			panel.removeEventListener('transitionend', onTransitionEnd)
			item.dataset.animating = 'false'

			if (expand) {
				panel.style.height = 'auto'
			} else {
				item.dataset.expanded = 'false'
				item.open = false
			}
		}

		panel.addEventListener('transitionend', onTransitionEnd)
	}

	for (const accordion of accordions) {
		for (const item of accordion.querySelectorAll('details')) {
			const summary = item.querySelector('summary')
			const panel = item.querySelector<HTMLElement>('.panel')

			if (!summary || !panel) continue

			setExpandedState(item, panel, item.open)

			summary.addEventListener('click', (event) => {
				event.preventDefault()

				if (item.dataset.animating === 'true') return

				animatePanel(item, panel, !item.open)
			})
		}
	}
</script>

<style>
	.accordion details {
		border-top: 1px solid var(--rule);
	}

	.accordion details:last-of-type {
		border-bottom: 1px solid var(--rule);
	}

	.accordion summary {
		display: grid;
		grid-template-columns: 1.75rem 1fr auto;
		align-items: center;
		gap: 2rem;
		padding: 1rem 0;
	}

	.accordion .num {
		color: var(--text-accent);
		letter-spacing: -0.02em;
	}

	.accordion .title {
		font-size: clamp(1.25rem, 1rem + 1vw, 1.5rem);
		font-weight: 600;
		line-height: 1.5;
		margin: 0;
	}

	.accordion .panel {
		height: 0;
		overflow: hidden;
		transition: height var(--duration-slow) var(--ease);
	}

	.accordion .body {
		display: grid;
		grid-template-columns: 1.75rem 1fr;
		column-gap: 2rem;
		padding-bottom: 1.5rem;
	}

	.accordion .body > * {
		grid-column: 2;
	}

	.accordion .body p {
		margin-bottom: 1rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.accordion .panel {
			transition: none;
		}
	}
</style>
