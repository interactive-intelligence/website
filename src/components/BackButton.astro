---
import { Icon } from 'astro-icon/components'

interface Props {
	href: string
	label: string
}

const { href, label } = Astro.props
---

<div class="back">
	<a href={href} class="btn btn-surface back-btn">
		<Icon aria-hidden="true" name="mingcute:arrow-left-line" class="arrow-left" />
		{label}
	</a>
</div>

<style>
	.back {
		margin-bottom: 1rem;
	}
</style>
