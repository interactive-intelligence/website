---
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'

interface Props {
	talk: CollectionEntry<'talks'>
}

const { talk } = Astro.props
const base = import.meta.env.BASE_URL

const dateFmt = new Intl.DateTimeFormat('en-US', {
	weekday: 'short',
	month: 'short',
	day: 'numeric',
	timeZone: 'America/Los_Angeles'
})

const timeFmt = new Intl.DateTimeFormat('en-US', {
	hour: 'numeric',
	minute: '2-digit',
	timeZone: 'America/Los_Angeles'
})

const meta = [dateFmt.format(talk.data.date), timeFmt.format(talk.data.date), talk.data.location]
	.filter(Boolean)
	.join(' · ')
---

<a class="btn btn-surface talk-card" href={`${base}talks/${talk.id}`}>
	<span class="talk-body">
		<span class="talk-title">{talk.data.speaker}: {talk.data.title}</span>
		<span class="talk-meta">
			<time datetime={talk.data.date.toISOString()}>{meta}</time>
		</span>
	</span>
	<Icon name="mingcute:arrow-right-line" class="talk-arrow" />
</a>

<style>
	.talk-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem;
	}

	.talk-body {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
		flex: 1;
	}

	.talk-title {
		font-weight: 500;
		font-size: 1.125rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.talk-meta {
		font-size: 0.875rem;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
	}

	.talk-arrow {
		color: var(--text-accent);
		font-size: 1.25em;
		margin-left: auto;
		flex-shrink: 0;
	}

	@media (max-width: 32rem) {
		.talk-title {
			white-space: normal;
		}
	}
</style>
