---
import type { CollectionEntry } from 'astro:content'
import { TIME_ZONE } from '../lib/dates'
import ListCard from './ListCard.astro'

interface Props {
	talk: CollectionEntry<'talks'>
}

const { talk } = Astro.props

const dateFmt = new Intl.DateTimeFormat('en-US', {
	weekday: 'short',
	month: 'short',
	day: 'numeric',
	timeZone: TIME_ZONE
})

const timeFmt = new Intl.DateTimeFormat('en-US', {
	hour: 'numeric',
	minute: '2-digit',
	timeZone: TIME_ZONE
})

const meta = [dateFmt.format(talk.data.date), timeFmt.format(talk.data.date), talk.data.location]
	.filter(Boolean)
	.join(' · ')
---

<ListCard
	href={`/talks/${talk.id}`}
	title={`${talk.data.speaker}: ${talk.data.title}`}
	meta={meta}
	datetime={talk.data.date.toISOString()}
/>
