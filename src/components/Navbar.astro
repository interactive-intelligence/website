---
import { getCollection } from 'astro:content';
import logoRaw from '../assets/i2logo.svg?raw';

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;

const links = [
	{ href: '/', label: 'Home' },
	{
		href: '/about',
		label: 'About',
		items: [
			{ href: '/about', label: 'About' },
			{ href: '/team', label: 'Team' },
			{ href: '/constitution', label: 'Constitution' }
		]
	},
	{ href: '/schedule', label: 'Schedule' },
	{ href: '/announcements', label: 'Announcements' },
	{ href: '/research', label: 'Research' },
	{ href: '/initiatives', label: 'Initiatives', dropdown: true }
];

const initiatives = (await getCollection('initiatives')).sort(
	(a, b) => a.data.order - b.data.order
);

const prefixed = (path: string) => base.replace(/\/?$/, '/') + path.replace(/^\//, '');

const isActive = (href: string) => {
	const full = prefixed(href);
	return href === '/' ? currentPath === full : currentPath.startsWith(full);
};

const initiativeHref = (data: { external_url?: string }, id: string) =>
	data.external_url ?? prefixed(`/initiatives/${id}`);
---

<nav>
	<a href={base} class="logo" aria-label="Home">
		<Fragment set:html={logoRaw} />
	</a>
	<ul>
		{
			links.map(({ href, label, dropdown, items }) => (
				<li class:list={[{ 'has-dropdown': dropdown || items }]}>
					<a href={prefixed(href)} class:list={[{ active: isActive(href) }]}>
						{label}
					</a>
					{items && (
						<ul class="submenu">
							{items.map((item) => (
								<li>
									<a href={prefixed(item.href)}>{item.label}</a>
								</li>
							))}
						</ul>
					)}
					{dropdown && (
						<ul class="submenu">
							{initiatives.map((init) => (
								<li>
									<a
										href={initiativeHref(init.data, init.id)}
										target={init.data.external_url ? '_blank' : undefined}
										rel={init.data.external_url ? 'noopener' : undefined}
									>
										{init.data.name}
									</a>
								</li>
							))}
							<li class="separator">
								<a href={prefixed('/initiatives')}>All initiatives</a>
							</li>
						</ul>
					)}
				</li>
			))
		}
	</ul>
	<a href={prefixed('/join')} class="btn btn-primary">Join Us</a>
</nav>

<style>
	nav {
		max-width: var(--container);
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.logo {
		width: 4rem;
		height: 4rem;
		padding: 0.25rem;
		background: var(--logo-bg);
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--border-logo-bg);
	}

	.logo :global(svg) {
		width: 100%;
		height: 100%;
	}

	ul {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
	}

	ul li {
		margin-top: 0;
	}

	ul a {
		display: inline-block;
		padding: 0.5rem 1rem;
		border-radius: var(--radius);
		font-weight: 500;
		background: var(--surface);
		border: 1px solid var(--border);
	}

	ul a:hover,
	ul a.active {
		background: var(--accent-light);
		border: 1px solid var(--border-accent-light);
	}

	.has-dropdown {
		position: relative;
	}

	.submenu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 50%;
		transform: translateX(-50%) translateY(-0.25rem);
		min-width: 12.5rem;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.5rem;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: calc(var(--radius-lg) - 0.25rem);
		box-shadow: 0 8px 24px hsl(260 40% 20% / 0.12);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.15s,
			transform 0.15s,
			visibility 0.15s;
		z-index: 10;
	}

	.has-dropdown:hover .submenu,
	.has-dropdown:focus-within .submenu {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
		display: flex;
	}

	.submenu li {
		margin: 0;
	}

	.submenu a {
		display: block;
		padding: 0.5rem 0.75rem;
		background: transparent;
		border: 1px solid transparent;
		border-radius: calc(var(--radius));
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.submenu a:hover {
		background: var(--accent-light);
		border-color: var(--border-accent-light);
	}

	.submenu .separator {
		border-top: 1px solid var(--border);
		padding-top: 0.25rem;
	}
</style>
