---
import { getCollection } from 'astro:content'
import logoRaw from '../assets/i2logo.svg?raw'
import { Icon } from 'astro-icon/components'

const base = import.meta.env.BASE_URL
const currentPath = Astro.url.pathname

const links = [
	{ href: '/', label: 'Home' },
	{
		href: '/about',
		label: 'About',
		items: [
			{ href: '/about', label: 'About' },
			{ href: '/team', label: 'Team' },
			{ href: '/constitution', label: 'Constitution' }
		]
	},
	{ href: '/schedule', label: 'Schedule' },
	{ href: '/announcements', label: 'Announcements' },
	{ href: '/initiatives', label: 'Initiatives', dropdown: true }
]

const initiatives = (await getCollection('initiatives')).sort((a, b) => a.data.order - b.data.order)

const prefixed = (path: string) => base.replace(/\/?$/, '/') + path.replace(/^\//, '')

const isActive = (href: string) => {
	const full = prefixed(href)
	return href === '/' ? currentPath === full : currentPath.startsWith(full)
}

const initiativeHref = (data: { external_url?: string }, id: string) =>
	data.external_url ?? prefixed(`/initiatives/${id}`)
---

<nav>
	<a href={base} class="logo" aria-label="Home">
		<Fragment set:html={logoRaw} />
	</a>
	<div class="drawer" id="menu">
		<ul>
			{
				links.map(({ href, label, dropdown, items }) => (
					<li class:list={[{ 'has-dropdown': dropdown || items }]}>
						<a
							href={prefixed(href)}
							class:list={['btn btn-surface', { active: isActive(href) }]}
						>
							{label}
						</a>
						{items && (
							<ul class="submenu">
								{items.map((item) => (
									<li class:list={[{ duplicate: item.href === href }]}>
										<a href={prefixed(item.href)}>{item.label}</a>
									</li>
								))}
							</ul>
						)}
						{dropdown && (
							<ul class="submenu">
								{initiatives.map((init) => (
									<li>
										<a
											href={initiativeHref(init.data, init.id)}
											target={init.data.external_url ? '_blank' : undefined}
											rel={init.data.external_url ? 'noopener' : undefined}
										>
											{init.data.name}
										</a>
									</li>
								))}
								<li
									class="separator duplicate"
									role="separator"
									aria-hidden="true"
								/>
								<li class="duplicate">
									<a href={prefixed('/initiatives')}>All initiatives</a>
								</li>
							</ul>
						)}
					</li>
				))
			}
		</ul>
		<a href={prefixed('/join')} class="btn btn-primary">Join Us</a>
	</div>
	<button
		class="btn btn-surface menu-toggle"
		aria-label="Menu"
		aria-controls="menu"
		aria-expanded="false"
	>
		<Icon name="mingcute:menu-line" class="icon-open" />
		<Icon name="mingcute:close-line" class="icon-close" />
	</button>
</nav>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!
	toggle.addEventListener('click', () => {
		const open = document.body.classList.toggle('menu-open')
		toggle.setAttribute('aria-expanded', String(open))
	})
</script>

<style>
	nav {
		max-width: var(--container);
		margin: 0 auto;
		padding: 1rem var(--gutter);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.drawer {
		display: contents;
	}

	.logo {
		flex-shrink: 0;
		width: 4rem;
		height: 4rem;
		padding: 0.25rem;
		background: var(--logo-bg);
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--border-logo-bg);
	}

	.logo :global(svg) {
		width: 100%;
		height: 100%;
	}

	ul {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
	}

	ul li {
		margin-top: 0;
	}

	.has-dropdown {
		position: relative;
	}

	/* Floating menu card, shared by desktop dropdowns and the mobile drawer. */
	.submenu,
	.drawer {
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.5rem;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: calc(var(--radius-lg) - 0.25rem);
		box-shadow: var(--shadow);
	}

	.submenu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 50%;
		transform: translateX(-50%) translateY(-0.25rem);
		min-width: 12.5rem;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--duration-fast) var(--ease),
			transform var(--duration-fast) var(--ease),
			visibility var(--duration-fast) var(--ease);
		z-index: 10;
	}

	.has-dropdown:hover .submenu,
	.has-dropdown:focus-within .submenu {
		opacity: 1;
		visibility: visible;
		transform: translateX(-50%) translateY(0);
		display: flex;
	}

	.submenu li {
		margin: 0;
	}

	.submenu a {
		display: block;
		padding: 0.5rem 0.75rem;
		background: transparent;
		border: 1px solid transparent;
		border-radius: var(--radius);
		font-size: 0.875rem;
		font-weight: 500;
		white-space: nowrap;
		transition:
			background var(--duration-fast) var(--ease),
			border-color var(--duration-fast) var(--ease),
			transform var(--duration-fast) var(--ease);
	}

	.submenu a:hover {
		background: var(--accent-light);
		border-color: var(--border-accent-light);
		transform: scale(1.02);
	}

	.submenu a:active {
		transform: scale(0.98);
	}

	.submenu .separator {
		height: 1px;
		background: var(--border);
		margin: 0.25rem 0.25rem;
	}

	.menu-toggle {
		display: none;
		padding: 0.5rem;
		font-size: 1.5rem;
	}

	.icon-close,
	:global(.menu-open) .icon-open {
		display: none;
	}

	:global(.menu-open) .icon-close {
		display: block;
	}

	/* Collapse the links into a dropdown card under the toggle. */
	@media (max-width: 56rem) {
		.logo {
			width: 3.5rem;
			height: 3.5rem;
		}

		.menu-toggle {
			display: inline-flex;
		}

		.drawer {
			display: flex;
			position: fixed;
			top: 6rem;
			right: var(--gutter);
			left: var(--gutter);
			z-index: 10;
			max-height: calc(100dvh - 8rem);
			padding: 0.75rem;
			overflow-y: auto;
			opacity: 0;
			visibility: hidden;
			translate: 0 -0.25rem;
			transition:
				opacity var(--duration-fast) var(--ease),
				visibility var(--duration-fast) var(--ease),
				translate var(--duration-fast) var(--ease);
		}

		:global(.menu-open) .drawer {
			opacity: 1;
			visibility: visible;
			translate: 0;
		}

		:global(body.menu-open) {
			overflow: hidden;
		}

		.drawer ul {
			flex-direction: column;
			gap: 0.25rem;
		}

		/* Top-level links drop their button chrome to match submenu items. */
		.drawer > ul > li > a {
			display: flex;
			padding: 0.5rem 1rem;
			background: none;
			border-color: transparent;
		}

		.drawer > ul > li > a:hover,
		.drawer > ul > li > a.active {
			background: var(--accent-light);
			border-color: var(--border-accent-light);
		}

		/* Submenus become always-visible indented lists; hover popovers don't work on touch. */
		.drawer .has-dropdown .submenu {
			position: static;
			transform: none;
			opacity: 1;
			visibility: inherit;
			padding: 0.25rem 0 0.25rem 1rem;
			border: none;
			box-shadow: none;
			transition: none;
		}

		/* No hover motion inside the drawer. */
		.drawer a {
			transition: none;
		}

		.drawer a:hover {
			transform: none;
		}

		.drawer .submenu a {
			padding: 0.5rem 1rem;
			font-size: 1rem;
		}

		.duplicate {
			display: none;
		}

		.drawer > .btn-primary {
			justify-content: center;
			margin-top: 0.25rem;
		}
	}
</style>
