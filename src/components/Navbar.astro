---
import logoRaw from '../assets/i2logo.svg?raw'

const base = import.meta.env.BASE_URL
const currentPath = Astro.url.pathname

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/schedule', label: 'Schedule' },
	{ href: '/team', label: 'Team' },
	{ href: '/research', label: 'Research' },
	{ href: '/initiatives', label: 'Initiatives' }
]

const prefixed = (path: string) => base.replace(/\/?$/, '/') + path.replace(/^\//, '')

const isActive = (href: string) => {
	const full = prefixed(href)
	return href === '/' ? currentPath === full : currentPath.startsWith(full)
}
---

<nav>
	<a href={base} class="logo" aria-label="Home">
		<Fragment set:html={logoRaw} />
	</a>
	<ul>
		{
			links.map(({ href, label }) => (
				<li>
					<a href={prefixed(href)} class:list={[{ active: isActive(href) }]}>
						{label}
					</a>
				</li>
			))
		}
	</ul>
	<a href={prefixed('/join')} class="btn btn-primary">Join Us</a>
</nav>

<style>
	nav {
		max-width: var(--container);
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.logo {
		width: 4rem;
		height: 4rem;
		padding: 0.25rem;
		background: var(--logo-tile);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.logo :global(svg) {
		width: 100%;
		height: 100%;
	}

	ul {
		display: flex;
		gap: 0.5rem;
		list-style: none;
	}

	ul li {
		margin-top: 0;
	}

	ul a {
		display: inline-block;
		padding: 0.5rem 1rem;
		border-radius: var(--radius);
		font-weight: 500;
		background: var(--surface);
		border: 1px solid var(--border);
	}

	ul a:hover,
	ul a.active {
		background: var(--accent-light);
		border: 1px solid var(--border-accent-light);
	}
</style>
