---
import 'katex/dist/katex.min.css'
import { Icon } from 'astro-icon/components'
import Layout from './Layout.astro'
import { courseHref, getUnits, unitHref } from '../lib/course'

// Intro Course pages: a rail with the course contents beside the page.
// The current page's sections (`headings`) are listed under it in the rail.
// On phones the rail is a popover, opened from a button in the header.
interface Props {
	title: string
	description: string
	lede?: string
	headings?: { slug: string; text: string }[]
}

const { title, description, lede, headings = [] } = Astro.props
const { core, optional } = await getUnits()
const current = Astro.url.pathname.replace(/\/$/, '')
// The home page's heading is the course name, so its title says "Home" instead.
const pageTitle = `${current === courseHref ? 'Home' : title} - Intro Course - i2`

const groups = [
	{
		items: [
			{ href: courseHref, label: 'Home' },
			{ href: `${courseHref}/schedule`, label: 'Schedule' },
			{ href: `${courseHref}/resources`, label: 'Resources' },
			{ href: `${courseHref}/staff`, label: 'Staff' },
			{ href: `${courseHref}/graduates`, label: 'Graduates' }
		]
	},
	{
		label: 'Core units',
		items: core.map((u) => ({ href: unitHref(u), label: u.data.title, num: u.data.unit }))
	},
	{
		label: 'Optional units',
		items: optional.map((u) => ({ href: unitHref(u), label: u.data.title }))
	}
]
---

<Layout title={pageTitle} description={description}>
	<button slot="navbar" class="btn btn-surface contents-toggle" popovertarget="course-nav">
		<span class="long-label">Course contents</span>
		<span class="short-label">Contents</span>
		<Icon aria-hidden="true" name="mingcute:down-line" />
	</button>
	<div class="course">
		<aside class="rail">
			<nav class="course-nav" id="course-nav" aria-label="Intro Course" popover>
				{
					groups.map((group) => (
						<div class="group">
							{group.label && <p class="label group-label">{group.label}</p>}
							<ul class="list-reset">
								{group.items.map((item) => (
									<li>
										<a
											href={item.href}
											aria-current={item.href === current ? 'page' : undefined}
										>
											{'num' in item && <span class="num">{item.num}</span>}
											{item.label}
										</a>
										{item.href === current && headings.length > 0 && (
											<ul class="list-reset sections">
												{headings.map((h) => (
													<li>
														<a href={`#${h.slug}`}>{h.text}</a>
													</li>
												))}
											</ul>
										)}
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>
		</aside>

		<div class="body">
			<header class="page-header">
				<h1>{title}</h1>
				{lede && <p class="lede">{lede}</p>}
			</header>
			<slot />
		</div>
	</div>
</Layout>

<script>
	const nav = document.getElementById('course-nav')!

	// Close after following a link, including one to a section of this page.
	nav.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a') && nav.matches(':popover-open')) nav.hidePopover()
	})

	// Only one menu at a time: opening the contents closes the site menu.
	nav.addEventListener('toggle', (e) => {
		if ((e as ToggleEvent).newState === 'open' && document.body.classList.contains('menu-open')) {
			document.querySelector<HTMLButtonElement>('.menu-toggle')!.click()
		}
	})
</script>

<script>
	// Draw ```mermaid code blocks as diagrams, themed from the site's colors.
	// The library is only downloaded on pages that have one.
	const diagrams = [...document.querySelectorAll('pre > code.language-mermaid')].map((code) => {
		const figure = document.createElement('figure')
		figure.className = 'mermaid'
		figure.textContent = code.textContent
		code.parentElement!.replaceWith(figure)
		return figure
	})

	if (diagrams.length > 0) {
		const { default: mermaid } = await import('mermaid')
		const style = getComputedStyle(document.documentElement)
		const token = (name: string) => style.getPropertyValue(name).trim()
		mermaid.initialize({
			startOnLoad: false,
			// Mermaid's default ELK layout is a ~1.5 MB download. Dagre is small and fine for course diagrams.
			layout: 'dagre',
			theme: 'base',
			fontFamily: getComputedStyle(document.body).fontFamily,
			themeVariables: {
				background: token('--bg'),
				primaryColor: token('--surface'),
				primaryBorderColor: token('--accent-light-border'),
				primaryTextColor: token('--text'),
				lineColor: token('--text-accent'),
				edgeLabelBackground: token('--bg')
			}
		})
		await mermaid.run({ nodes: diagrams })
	}
</script>

<style>
	.course {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		column-gap: 3rem;
	}

	/* Wide screens show the rail in place, so undo the browser's popover styles. */
	.course-nav {
		display: grid;
		position: static;
		inset: auto;
		width: auto;
		height: auto;
		margin: 0;
		overflow: visible;
		color: inherit;
		gap: 1rem;
		padding: 0.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.group-label {
		margin: 0.5rem 1rem 0.25rem;
	}

	.course-nav ul {
		display: grid;
		gap: 0.25rem;
	}

	/* Pills like the site menu's links, packed a little tighter. */
	.course-nav a {
		display: flex;
		gap: 0.5rem;
		padding: 0.375rem 1rem;
		border: 1px solid transparent;
		border-radius: var(--radius);
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.4;
		transition:
			background var(--duration-fast) var(--ease),
			border-color var(--duration-fast) var(--ease);
	}

	.course-nav a:hover,
	.course-nav a[aria-current='page'] {
		background: var(--accent-light);
		border-color: var(--accent-light-border);
	}

	.num {
		min-width: 0.75rem;
		color: var(--text-accent);
		font-variant-numeric: tabular-nums;
	}

	.sections {
		margin: 0.25rem 0 0.25rem 1rem;
		padding-left: 0.5rem;
		border-left: 1px solid var(--rule);
	}

	.sections a {
		padding: 0.25rem 0.75rem;
		font-size: 0.875rem;
		font-weight: 400;
	}

	.contents-toggle {
		display: none;
	}

	@media (max-width: 48rem) {
		.course {
			grid-template-columns: minmax(0, 1fr);
		}

		.contents-toggle {
			display: inline-flex;
			margin-left: auto;
		}

		.contents-toggle :global(svg) {
			transition: rotate var(--duration) var(--ease);
		}

		:global(body:has(#course-nav:popover-open)) .contents-toggle :global(svg) {
			rotate: 180deg;
		}

		.short-label {
			display: none;
		}

		.course-nav:not(:popover-open) {
			display: none;
		}

		/* A floating card under the header, like the site menu. */
		.course-nav:popover-open {
			position: fixed;
			inset: 6rem var(--gutter) auto;
			max-height: calc(100dvh - 8rem);
			padding: 0.75rem;
			overflow-y: auto;
			overscroll-behavior: contain;
			background: var(--bg);
			border-radius: calc(var(--radius-lg) - 0.25rem);
			box-shadow: var(--shadow);
		}
	}

	/* The smallest phones only have room for a shorter label beside the logo and menu button. */
	@media (max-width: 22rem) {
		.long-label {
			display: none;
		}

		.short-label {
			display: inline;
		}
	}
</style>
