---
import { getImage, Font } from 'astro:assets'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import logoCard from '../assets/social-logo.png'
import '../styles/global.css'

interface Props {
	title?: string
	description?: string
	/** Wide social preview photo. Without one, links show the logo as a small thumbnail. */
	image?: ImageMetadata
	/** Open Graph type. Use "article" for dated posts. */
	type?: 'website' | 'article'
}

const siteName = 'interactive intelligence'
const {
	title = siteName,
	description = "interactive intelligence (i2) is the University of Washington's student-led NeuroAI education and research organization.",
	image,
	type = 'website'
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const social = image
	? await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
	: await getImage({ src: logoCard, width: 1200, height: 1200, format: 'png' })
const socialImage = new URL(social.src, Astro.site)
const twitterCard = image ? 'summary_large_image' : 'summary'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-sans" preload={[400, 500, 600, 700].map((weight) => ({ weight, style: 'normal' }))} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<meta property="og:site_name" content={siteName} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content={social.attributes.width} />
		<meta property="og:image:height" content={social.attributes.height} />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:site" content="@InteractiveInt9" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />

		<slot name="head" />

		<style>
			html,
			body {
				background: hsl(260, 50%, 95%);
			}
		</style>
	</head>
	<body>
		<a href="#main" class="btn btn-primary skip-link">Skip to content</a>
		<Navbar />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script>
			document.addEventListener('click', (e) => {
				const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.heading-anchor')
				if (!link) return
				navigator.clipboard?.writeText(new URL(link.href, location.href).toString())
			})
		</script>
	</body>
</html>
