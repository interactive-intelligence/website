---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/fonts.css";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "interactive intelligence" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>html,body{background:hsl(260,50%,95%)}</style>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.heading-anchor')
        if (!link) return
        navigator.clipboard?.writeText(new URL(link.href, location.href).toString())
      })
    </script>
  </body>
</html>