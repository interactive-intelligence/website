---
import Layout from './Layout.astro'
import BackButton from '../components/BackButton.astro'

// A dated post (an announcement or a talk): a rail with the back button and the post's
// details beside its title, summary, and body.
// Slots: `details` for the rail's <dt>/<dd> pairs, `header` for anything after the summary,
// `head` for extra <head> tags, and the default slot for the body.
interface Props {
	title: string
	description?: string
	summary?: string
	published: Date
}

const { title, description, summary, published } = Astro.props
---

<Layout title={`${title} - i2`} description={description} type="article">
	<meta slot="head" property="article:published_time" content={published.toISOString()} />
	<slot name="head" slot="head" />
	<article class="article">
		<aside class="rail">
			<BackButton href="/announcements" label="All announcements" />
			<dl class="meta">
				<slot name="details" />
			</dl>
		</aside>

		<div class="body">
			<header class="page-header">
				<h1>{title}</h1>
				{summary && <p class="lede">{summary}</p>}
				<slot name="header" />
			</header>
			<slot />
		</div>
	</article>
</Layout>

<style>
	.article {
		display: grid;
		grid-template-columns: 13rem minmax(0, 1fr);
		column-gap: 4rem;
	}

	.rail {
		position: sticky;
		top: 2rem;
		align-self: start;
	}

	.meta {
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 1rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.meta :global(dt) {
		margin-bottom: 0.25rem;
	}

	.meta :global(dd) {
		margin: 0;
		font-size: 0.9375rem;
	}

	.lede {
		font-size: 1.125rem;
	}

	.body > :global(.prose) {
		margin-top: 0;
	}

	@media (max-width: 48rem) {
		.article {
			grid-template-columns: minmax(0, 1fr);
			row-gap: 1.5rem;
		}

		.rail {
			position: static;
		}
	}
</style>
